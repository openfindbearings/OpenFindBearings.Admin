@{
    Layout = null;
    ViewData["Title"] = "登录";
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpenFindBearings</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #2a3f54 0%, #1a2a3a 100%);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        .login-container {
            display: flex;
            gap: 24px;
            max-width: 820px;
            width: 95%;
        }
        .login-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,.2);
            padding: 48px 40px;
            text-align: center;
            flex: 1;
            min-width: 320px;
        }
        .login-logo {
            font-size: 48px;
            color: #1abb9c;
            margin-bottom: 16px;
        }
        .login-title {
            font-size: 24px;
            font-weight: 600;
            color: #2a3f54;
            margin-bottom: 8px;
        }
        .login-subtitle {
            font-size: 14px;
            color: #6c757d;
            margin-bottom: 32px;
        }
        .btn-login {
            background: #1abb9c;
            border: none;
            padding: 12px 32px;
            font-size: 16px;
            font-weight: 500;
            border-radius: 6px;
            transition: background .2s;
        }
        .btn-login:hover {
            background: #18a08a;
        }
        .login-footer {
            margin-top: 24px;
            font-size: 12px;
            color: #adb5bd;
        }
        .status-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,.2);
            padding: 24px;
            flex: 0 0 340px;
        }
        .status-card h6 {
            color: #2a3f54;
            font-weight: 600;
            margin-bottom: 16px;
        }
        .status-table {
            width: 100%;
            font-size: 13px;
        }
        .status-table td {
            padding: 8px 4px;
            border-bottom: 1px solid #f0f0f0;
        }
        .status-table td:first-child {
            font-weight: 500;
            color: #2a3f54;
            width: 80px;
        }
        .status-table tr:last-child td {
            border-bottom: none;
        }
        .badge { font-size: 11px; padding: 3px 8px; }

        /* 移动端适配：窄屏纵向堆叠，登录卡在上、服务状态在下，避免两栏溢出/挤压 */
        @@media (max-width: 768px) {
            body {
                align-items: flex-start;
                padding: 24px 0;
            }
            .login-container {
                flex-direction: column;
                gap: 16px;
                width: 92%;
                max-width: 420px;
            }
            .login-card {
                padding: 32px 20px;
                min-width: 0;
            }
            .status-card {
                flex: 1 1 auto; /* 覆盖桌面端 flex:0 0 340px，纵向时该值会变高度撑坏 */
            }
            .login-logo { font-size: 40px; }
            .login-title { font-size: 20px; }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-logo">
                <i class="fas fa-cog"></i>
            </div>
            <h1 class="login-title">OpenFindBearings</h1>
            <p class="login-subtitle">轴承信息管理后台</p>

            <form asp-action="LoginAction" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <button type="submit" class="btn btn-login text-white">
                    <i class="fas fa-sign-in-alt"></i> 登录管理后台
                </button>
            </form>

            @* 改动说明（v2.19.0）：页脚年份统一取 UTC，原 DateTime.Now 违反全项目时间与时区规则（禁止服务层取本地时间） *@
            <p class="login-footer">© @DateTime.UtcNow.Year OpenFindBearings</p>
        </div>

        <div class="status-card">
            <h6><i class="fas fa-heartbeat"></i> 服务状态</h6>
            @* 改动说明（v1.38.0 共享组件）：服务状态表改由共享组件渲染，按 /Home/Status 遍历生成行 *@
            @await Component.InvokeAsync("ServiceStatus", new { cssClass = "status-table", showDetails = false })
        </div>
    </div>

    </body>
</html>
