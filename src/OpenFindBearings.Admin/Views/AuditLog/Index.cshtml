@using OpenFindBearings.Admin.Models.DTOs
@{
    ViewData["Title"] = "审计日志";
    var source = ViewBag.Source as string ?? "identity";
    var items = ViewBag.Items as List<AuditLogItemDto> ?? [];
    var page = ViewBag.Page as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 30;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var totalPages = ViewBag.TotalPages as int? ?? 0;
    var error = ViewBag.Error as string;
    // UTC+8 北京时间格式化
    string BdTime(DateTimeOffset dt, string fmt = "yyyy-MM-dd HH:mm:ss") =>
        dt.AddHours(8).ToString(fmt);
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">审计日志</h6>
        <div class="d-flex gap-2">
            <div class="btn-group btn-group-sm">
                <a href="?source=identity&page=1" class="btn btn-outline-secondary @(source=="identity"?"active":"")">管理员</a>
                <a href="?source=api&page=1" class="btn btn-outline-secondary @(source=="api"?"active":"")">API</a>
                <a href="?source=sync&page=1" class="btn btn-outline-secondary @(source=="sync"?"active":"")">Sync</a>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-warning m-3">@error</div>
        }
        <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>时间</th>
                    <th>用户</th>
                    <th>操作</th>
                    <th>请求</th>
                    <th>资源</th>
                    <th>IP</th>
                    <th>结果</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (items.Count > 0)
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="text-nowrap text-muted small">@BdTime(item.CreatedAt)</td>
                            <td>@(item.Username ?? "-")</td>
                            <td><span class="badge @item.ActionBadgeClass">@item.ActionDisplay</span></td>
                            <td class="text-muted small">
                                @if (!string.IsNullOrEmpty(item.HttpMethod))
                                {
                                    <span class="badge bg-light text-dark border me-1">@item.HttpMethod</span>@item.RequestPath
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @item.ResourceTypeDisplay
                                @if (!string.IsNullOrEmpty(item.ResourceId) && item.ResourceId != Guid.Empty.ToString())
                                {
                                    <span class="text-muted ms-1">#@(item.ResourceId.Length > 12 ? item.ResourceId[..12] + "..." : item.ResourceId)</span>
                                }
                            </td>
                            <td>@(item.IpAddress ?? "-")</td>
                            <td>
                                @if (item.StatusCode.HasValue)
                                {
                                    <span class="badge @item.StatusBadgeClass">@item.ResultDisplay</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Details))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary detail-btn" data-bs-toggle="modal" data-bs-target="#auditDetailModal" data-details="@item.Details">详情</button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">@(error ?? "暂无日志")</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">共 @totalPages 页 / @totalCount 条</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(page<=1?"disabled":"")">
                        <a class="page-link" href="?source=@source&page=1"><i class="fas fa-angle-double-left"></i></a>
                    </li>
                    <li class="page-item @(page<=1?"disabled":"")">
                        <a class="page-link" href="?source=@source&page=@(page-1)"><i class="fas fa-angle-left"></i></a>
                    </li>
                    @{
                        var startPage = Math.Max(1, page - 2);
                        var endPage = Math.Min(totalPages, page + 2);
                        if (startPage > 1)
                        {
                            <li class="page-item disabled"><a class="page-link" href="#">...</a></li>
                        }
                        for (var p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item @(p==page?"active":"")">
                                <a class="page-link" href="?source=@source&page=@p">@p</a>
                            </li>
                        }
                        if (endPage < totalPages)
                        {
                            <li class="page-item disabled"><a class="page-link" href="#">...</a></li>
                        }
                    }
                    <li class="page-item @(page>=totalPages?"disabled":"")">
                        <a class="page-link" href="?source=@source&page=@(page+1)"><i class="fas fa-angle-right"></i></a>
                    </li>
                    <li class="page-item @(page>=totalPages?"disabled":"")">
                        <a class="page-link" href="?source=@source&page=@totalPages"><i class="fas fa-angle-double-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<div class="modal fade" id="auditDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title mb-0">操作详情</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <pre id="auditDetailContent" class="mb-0" style="white-space: pre-wrap; word-break: break-all; font-size: 0.85rem;">-</pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">关闭</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.detail-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('auditDetailContent').textContent = btn.getAttribute('data-details') || '(无详情)';
            });
        });
    </script>
}
