@{
    ViewData["Title"] = "系统配置";
    // 按 Group 分组的配置列表
    var groupedItems = ViewBag.GroupedItems as IEnumerable<IGrouping<string, SystemConfigDto>>;
    // 积分赚分规则（v1.28.0 由独立"积分任务"页并入本页"积分任务"tab）
    var pointRules = ViewBag.PointRules as List<OpenFindBearings.Admin.Models.DTOs.PointRuleDto> ?? new();
    // 商家集体任务定义（v2.6.0 M3 新增"商家任务"tab）
    var merchantTasks = ViewBag.MerchantTasks as List<OpenFindBearings.Admin.Models.DTOs.MerchantTaskDto> ?? new();
    // 段位档位表（v2.12.0 等级玩法新增"等级段位"tab）
    var pointLevels = ViewBag.PointLevels as List<OpenFindBearings.Admin.Models.DTOs.PointLevelDto> ?? new();

    // 分组名映射为中文
    // 改动说明：v1.28.0 补 Business 组映射（BusinessClock 时区偏移种子落此组）；
    //           移除 General / Performance / RateLimit / Reliability 四项历史残留映射
    var groupNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Site"] = "站点设置",
        ["Price"] = "价格显示",
        ["Sync"] = "数据同步",
        ["Business"] = "业务设置"
    };

    // tab 展示次序：常用组在前，未知组按字母序垫底（积分任务恒为最后一个 tab）
    var tabOrder = new[] { "Site", "Price", "Sync", "Business" };
    var orderedGroups = (groupedItems ?? Enumerable.Empty<IGrouping<string, SystemConfigDto>>())
        .OrderBy(g =>
        {
            var idx = Array.FindIndex(tabOrder, t => string.Equals(t, g.Key, StringComparison.OrdinalIgnoreCase));
            return idx >= 0 ? idx : tabOrder.Length;
        })
        .ThenBy(g => g.Key)
        .ToList();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* v1.28.0：系统配置由纵向多卡片改为 tab 页签组织，积分任务并入为最后一个页签；
   URL ?tab=xxx 记忆当前页签（保存回跳后不丢位置） *@
<ul class="nav nav-tabs ofb-tabs mb-3" role="tablist">
    @foreach (var group in orderedGroups)
    {
        var gk = group.Key;
        var dn = groupNames.TryGetValue(gk, out var n) ? n : gk;
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-@gk.ToLowerInvariant()-tab" data-bs-toggle="tab" data-bs-target="#tab-@gk.ToLowerInvariant()"
                    type="button" role="tab" data-tabkey="@gk">
                <i class="fas fa-cog me-1"></i>@dn
            </button>
        </li>
    }
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-points-tab" data-bs-toggle="tab" data-bs-target="#tab-points"
                type="button" role="tab" data-tabkey="points">
            <i class="fas fa-coins me-1"></i>积分任务
        </button>
    </li>
    @* v2.12.0 等级玩法：段位档位表管理页签 *@
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-levels-tab" data-bs-toggle="tab" data-bs-target="#tab-levels"
                type="button" role="tab" data-tabkey="levels">
            <i class="fas fa-medal me-1"></i>等级段位
        </button>
    </li>
    @* v2.6.0 M3：商家集体任务定义管理页签 *@
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-merchattasks-tab" data-bs-toggle="tab" data-bs-target="#tab-merchattasks"
                type="button" role="tab" data-tabkey="merchattasks">
            <i class="fas fa-users me-1"></i>商家任务
        </button>
    </li>
</ul>

<div class="tab-content">
    @foreach (var group in orderedGroups)
    {
        var gk = group.Key;
        var dn = groupNames.TryGetValue(gk, out var n) ? n : gk;
        <div class="tab-pane fade" id="tab-@gk.ToLowerInvariant()" role="tabpanel" aria-labelledby="tab-@gk.ToLowerInvariant()-tab">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-cog me-1"></i> @dn</h6>
                    <small class="text-muted">@group.Count() 项</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width:30%">配置键</th>
                                <th style="width:30%">配置值</th>
                                <th style="width:25%" class="d-none d-md-table-cell">描述</th>
                                <th style="width:15%" class="text-center">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group.OrderBy(i => i.Key))
                            {
                                <tr>
                                    <td><code class="text-primary">@item.Key</code></td>
                                    <td>
                                        @* 改动说明：布尔值展示与编辑控件共用同一套真值集合，
                                           避免 "1"/"yes"/"on" 显示为原始文本而无法识别开关状态 *@
                                        @if (item.ValueType == "bool")
                                        {
                                            var boolTrue = new[] { "true", "1", "yes", "y", "on" }
                                                .Contains((item.Value ?? "").Trim(), StringComparer.OrdinalIgnoreCase);
                                            if (boolTrue)
                                            {
                                                <span class="badge bg-success">开启</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">关闭</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>@item.Value</span>
                                        }
                                    </td>
                                    <td class="text-muted small d-none d-md-table-cell">@(item.Description ?? "-")</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary btn-edit-config"
                                                data-key="@item.Key"
                                                data-value="@item.Value"
                                                data-group="@item.Group"
                                                data-valuetype="@item.ValueType">
                                            <i class="fas fa-edit"></i> 编辑
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
            </div>
        </div>
    }

    @* 积分赚分规则 tab（原 Views/Points/Index.cshtml 并入；保存仍 POST /Points/SaveRules） *@
    <div class="tab-pane fade" id="tab-points" role="tabpanel" aria-labelledby="tab-points-tab">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="fas fa-coins me-1"></i> 积分赚分规则</h6>
                <small class="text-muted">分值/上限/阶梯/启停修改后实时生效，无需发版；合规红线：积分不可充值、不可提现、不可转让</small>
            </div>
            <form method="post" asp-controller="Points" asp-action="SaveRules">
                @Html.AntiForgeryToken()
                <div class="card-body p-0">
                    <div class="table-responsive"><table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>动作</th>
                                <th>类型标识</th>
                                <th style="width:90px">分值</th>
                                <th style="width:100px">每日上限</th>
                                <th style="width:150px">连续阶梯</th>
                                <th style="width:80px">状态</th>
                                <th class="d-none d-md-table-cell">说明</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < pointRules.Count; i++)
                            {
                                var item = pointRules[i];
                                <tr>
                                    <input type="hidden" name="items[@i].Id" value="@item.Id" />
                                    <td><strong>@item.DisplayName</strong></td>
                                    <td><code class="small">@item.GrantType</code></td>
                                    <td><input type="number" name="items[@i].Amount" value="@item.Amount" min="0" class="form-control form-control-sm" style="width:80px" /></td>
                                    <td><input type="number" name="items[@i].DailyLimit" value="@item.DailyLimit" min="0" class="form-control form-control-sm" style="width:90px" title="0 表示不限" /></td>
                                    <td><input type="text" name="items[@i].LadderJson" value="@item.LadderJson" class="form-control form-control-sm" style="width:140px" placeholder="如 [2,3,4,5,5]" /></td>
                                    @* 复选框标准模式：隐藏 false 垫底，未勾选也能提交 false（否则 unchecked 不发送=无法停用） *@
                                    <td>
                                        <input type="hidden" name="items[@i].IsEnabled" value="false" />
                                        <div class="form-check form-switch">
                                            <input type="checkbox" name="items[@i].IsEnabled" value="true" class="form-check-input" @(item.IsEnabled ? "checked" : "") />
                                        </div>
                                    </td>
                                    <td class="d-none d-md-table-cell"><small class="text-muted">@(item.Description ?? "-")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <small class="text-muted">每日上限=当日该动作累计发放封顶（0 不限）；连续阶梯为 JSON 数组按连续天数取档、超出取末档（仅签到类动作生效）；留空阶梯=固定分值。</small>
                    <button type="submit" class="btn btn-primary btn-sm" title="保存全部"><i class="fas fa-save me-1"></i><span class="d-none d-sm-inline">保存全部</span></button>
                </div>
            </form>
        </div>
    </div>

    @* v2.12.0 等级玩法：段位档位表（阈值/段位名/升档礼/启停，实时生效；Level 号锚定落档与幂等不可改） *@
    <div class="tab-pane fade" id="tab-levels" role="tabpanel" aria-labelledby="tab-levels-tab">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="fas fa-medal me-1"></i> 段位档位表</h6>
                <small class="text-muted">用户按累计获得轴承币落档；跨档一次性发升档礼（每用户每档终身一次）；改后实时生效</small>
            </div>
            <form method="post" asp-controller="Points" asp-action="SaveLevels">
                @Html.AntiForgeryToken()
                <div class="card-body p-0">
                    <div class="table-responsive"><table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th style="width:70px">等级</th>
                                <th style="width:170px">段位名</th>
                                <th style="width:150px">累计获得阈值</th>
                                <th style="width:120px">升档礼（币）</th>
                                <th style="width:80px">状态</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < pointLevels.Count; i++)
                            {
                                var item = pointLevels[i];
                                <tr>
                                    <input type="hidden" name="items[@i].Id" value="@item.Id" />
                                    <td><strong>Lv@(item.Level)</strong></td>
                                    <td><input type="text" name="items[@i].Name" value="@item.Name" class="form-control form-control-sm" maxlength="32" required /></td>
                                    <td><input type="number" name="items[@i].MinTotalEarned" value="@item.MinTotalEarned" min="0" class="form-control form-control-sm" style="width:140px" /></td>
                                    <td><input type="number" name="items[@i].LevelUpBonus" value="@item.LevelUpBonus" min="0" class="form-control form-control-sm" style="width:110px" title="0 表示该档不发升档礼" /></td>
                                    <td>
                                        <input type="hidden" name="items[@i].Enabled" value="false" />
                                        <div class="form-check form-switch">
                                            <input type="checkbox" name="items[@i].Enabled" value="true" class="form-check-input" @(item.Enabled ? "checked" : "") />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <small class="text-muted">阈值=累计获得轴承币达此值落该档（只升不降）；升档礼=跨入该档一次性发币，0=不发；停用档位不可达、自动落到下一启用档。@if (pointLevels.Count == 0) { <span class="text-danger">当前无档位数据。</span> }</small>
                    @if (pointLevels.Count > 0)
                    {
                        <button type="submit" class="btn btn-primary btn-sm" title="保存全部"><i class="fas fa-save me-1"></i><span class="d-none d-sm-inline">保存全部</span></button>
                    }
                </div>
            </form>
        </div>
    </div>

    @* v2.6.0 M3：商家集体任务定义（全商家成员共同推进的周期目标，达标即结算；TaskKey 锚定台账不可改） *@
    <div class="tab-pane fade" id="tab-merchattasks" role="tabpanel" aria-labelledby="tab-merchattasks-tab">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="fas fa-users me-1"></i> 商家集体任务</h6>
                <small class="text-muted">达标即结算（Job 每小时扫描）；目标/奖励/启停修改后实时生效</small>
            </div>
            <form method="post" asp-controller="Points" asp-action="SaveMerchantTasks">
                @Html.AntiForgeryToken()
                <div class="card-body p-0">
                    <div class="table-responsive"><table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>任务键</th>
                                <th style="width:130px">任务名</th>
                                <th style="width:150px">描述</th>
                                <th style="width:130px">指标</th>
                                <th style="width:90px">目标值</th>
                                <th style="width:100px">周期</th>
                                <th style="width:110px">奖励对象</th>
                                <th style="width:90px">奖励分值</th>
                                <th style="width:70px">排序</th>
                                <th style="width:70px">状态</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < merchantTasks.Count; i++)
                            {
                                var item = merchantTasks[i];
                                <tr>
                                    <input type="hidden" name="items[@i].Id" value="@item.Id" />
                                    <td><code class="small">@item.TaskKey</code></td>
                                    <td><input type="text" name="items[@i].Name" value="@item.Name" class="form-control form-control-sm" maxlength="64" /></td>
                                    <td><input type="text" name="items[@i].Description" value="@item.Description" class="form-control form-control-sm" maxlength="256" /></td>
                                    <td>
                                        <select name="items[@i].MetricKey" class="form-select form-select-sm">
                                            <option value="corrections" selected="@(item.MetricKey == "corrections")">成员纠错采纳</option>
                                            <option value="treasury" selected="@(item.MetricKey == "treasury")">金库入账额</option>
                                            <option value="products" selected="@(item.MetricKey == "products")">新上架商品数</option>
                                        </select>
                                    </td>
                                    <td><input type="number" name="items[@i].TargetValue" value="@item.TargetValue" min="1" class="form-control form-control-sm" style="width:80px" /></td>
                                    <td>
                                        <select name="items[@i].Period" class="form-select form-select-sm">
                                            <option value="1" selected="@(item.Period == 1)">每自然周</option>
                                            <option value="2" selected="@(item.Period == 2)">每自然月</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select name="items[@i].RewardType" class="form-select form-select-sm">
                                            <option value="1" selected="@(item.RewardType == 1)">全体成员</option>
                                            <option value="2" selected="@(item.RewardType == 2)">商家金库</option>
                                        </select>
                                    </td>
                                    <td><input type="number" name="items[@i].RewardAmount" value="@item.RewardAmount" min="1" class="form-control form-control-sm" style="width:80px" /></td>
                                    <td><input type="number" name="items[@i].SortOrder" value="@item.SortOrder" class="form-control form-control-sm" style="width:60px" /></td>
                                    <td>
                                        <input type="hidden" name="items[@i].Enabled" value="false" />
                                        <div class="form-check form-switch">
                                            <input type="checkbox" name="items[@i].Enabled" value="true" class="form-check-input" @(item.Enabled ? "checked" : "") />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <small class="text-muted">指标口径：成员纠错采纳=周期内在职成员 correction_adopted 流水条数；金库入账额=周期内金库全部入账；新上架商品数=周期内新建商品关联（含待审核）。@if (merchantTasks.Count == 0) { <span class="text-danger">当前无任务定义。</span> }</small>
                    @if (merchantTasks.Count > 0)
                    {
                        <button type="submit" class="btn btn-primary btn-sm" title="保存全部"><i class="fas fa-save me-1"></i><span class="d-none d-sm-inline">保存全部</span></button>
                    }
                </div>
            </form>
        </div>
        @* 新建任务表单（TaskKey 全局唯一、创建后不可变） *@
        <div class="card mt-3">
            <div class="card-header"><h6 class="mb-0"><i class="fas fa-plus me-1"></i> 新建任务</h6></div>
            <form method="post" asp-controller="Points" asp-action="CreateMerchantTask">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-2">
                            <label class="form-label small">任务键（唯一，如 merchant_xxx_week）</label>
                            <input type="text" name="TaskKey" class="form-control form-control-sm" maxlength="64" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">任务名</label>
                            <input type="text" name="Name" class="form-control form-control-sm" maxlength="64" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">描述</label>
                            <input type="text" name="Description" class="form-control form-control-sm" maxlength="256" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">指标</label>
                            <select name="MetricKey" class="form-select form-select-sm">
                                <option value="corrections">成员纠错采纳</option>
                                <option value="treasury">金库入账额</option>
                                <option value="products">新上架商品数</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">目标值</label>
                            <input type="number" name="TargetValue" value="5" min="1" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">周期</label>
                            <select name="Period" class="form-select form-select-sm">
                                <option value="1">周</option>
                                <option value="2">月</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">奖励对象</label>
                            <select name="RewardType" class="form-select form-select-sm">
                                <option value="1">成员</option>
                                <option value="2">金库</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">奖励分值</label>
                            <input type="number" name="RewardAmount" value="20" min="1" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">排序</label>
                            <input type="number" name="SortOrder" value="10" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>创建任务</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 编辑配置弹窗 -->
<div class="modal fade" id="configModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">编辑配置</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="Update">
                <div class="modal-body">
                    <input type="hidden" name="key" id="configKey" />
                    @* v1.28.0：随表单提交当前页签，保存回跳后停留在原 tab *@
                    <input type="hidden" name="tab" id="configTab" value="" />
                    <div class="mb-3">
                        <label class="form-label">配置键</label>
                        @* 改动说明：disabled 改 readonly——键名本就不参与提交（提交走 hidden key），
                           readonly 允许选中复制键名，且配合 site.css 主题化只读样式在深色下可读 *@
                        <input type="text" class="form-control" id="configKeyDisplay" readonly tabindex="-1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">配置值 <span id="configValueTypeHint" class="text-muted small"></span></label>
                        <!-- 改动说明：原为单一文本框且带 required，布尔与数值配置只能靠人工输入文本，
                             填成 "0" 会被服务端静默回退为 true；备案号等可留空项也无法清空。
                             改为按 ValueType 渲染对应控件，并去掉 required 允许留空 -->
                        <input type="text" name="value" class="form-control" id="configValue" />
                        <select name="value" class="form-select d-none" id="configValueBool" disabled>
                            <option value="true">开启</option>
                            <option value="false">关闭</option>
                        </select>
                        <input type="number" name="value" class="form-control d-none" id="configValueNumber" step="1" disabled />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
// v1.28.0：tab 记忆——URL ?tab=xxx 激活对应页签；无参数默认第一个
(function(){
    var params = new URLSearchParams(window.location.search);
    var want = (params.get('tab') || '').toLowerCase();
    var target = want ? document.getElementById('tab-' + want + '-tab') : null;
    if (!target) { target = document.querySelector('.nav-tabs .nav-link'); }
    if (target) { new bootstrap.Tab(target).show(); }
})();

// 按配置值类型切换编辑控件：bool 用下拉、int 用数字框、其余用文本框
var cfgText = document.getElementById('configValue');
var cfgBool = document.getElementById('configValueBool');
var cfgNumber = document.getElementById('configValueNumber');
var cfgHint = document.getElementById('configValueTypeHint');

// 改动说明：真值集合必须与 API 侧 SystemConfigRepository.TryParseBool 及
//           UpdateSystemConfigCommandValidator 的识别范围完全一致。
//           原先只认字面量 "true"，配置值为 "1"/"yes"/"on" 时会显示成"关闭"，
//           管理员一打开就保存会把 true 静默改成 false，与修复目标直接冲突
var BOOL_TRUE_VALUES = ['true', '1', 'yes', 'y', 'on'];

function isTruthy(value){
    return BOOL_TRUE_VALUES.indexOf((value || '').trim().toLowerCase()) >= 0;
}

function setEditor(type, value){
    var isBool = type === 'bool';
    var isInt = type === 'int';
    // 同一 name 只允许一个控件参与提交，其余必须禁用（HTML 规范：disabled 控件不参与提交）
    cfgText.disabled = isBool || isInt;
    cfgBool.disabled = !isBool;
    cfgNumber.disabled = !isInt;
    cfgText.classList.toggle('d-none', isBool || isInt);
    cfgBool.classList.toggle('d-none', !isBool);
    cfgNumber.classList.toggle('d-none', !isInt);
    cfgHint.textContent = isBool ? '(布尔)' : isInt ? '(整数)' : '(文本)';

    // 布尔控件只提交规范化的 true/false，避免把 "1"/"yes" 原样回写
    if (isBool) cfgBool.value = isTruthy(value) ? 'true' : 'false';
    else if (isInt) cfgNumber.value = value || '0';
    else cfgText.value = value || '';
}

document.querySelectorAll('.btn-edit-config').forEach(function(btn){
    btn.addEventListener('click', function(){
        document.getElementById('configKey').value = this.dataset.key;
        document.getElementById('configKeyDisplay').value = this.dataset.key;
        // 记录当前页签随表单提交，保存后回跳原位
        document.getElementById('configTab').value = this.dataset.group || '';
        setEditor(this.dataset.valuetype || 'string', this.dataset.value);
        new bootstrap.Modal(document.getElementById('configModal')).show();
    });
});
</script>
}
