@{
    ViewData["Title"] = "信息纠错审核";
    var items = ViewBag.Items as IEnumerable<CorrectionItemDto> ?? Enumerable.Empty<CorrectionItemDto>();
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var currentStatus = (string?)ViewBag.CurrentStatus ?? "pending";
    var totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    string PageUrl(int p) => $"?status={currentStatus}&page={p}";
    // 改动说明：输出 UTC ISO 8601 字符串，由全局 data-utc JS 按浏览器时区显示
    string BdTimeRaw(DateTime? dt) => dt.HasValue ? dt.Value.ToString("yyyy-MM-ddTHH:mm:ssZ") : "-";
    // 改动说明（v1.47.1 卡级申诉联动）：把纠错建议值（"金牌"/"银牌"/…或数字）折算成调级页枚举值，
    //   无法识别时返回 0（调级页按默认档位处理，管理员须自行确认）
    int CorrectionGradeValue(string? suggested)
    {
        var v = (suggested ?? string.Empty).Trim();
        if (int.TryParse(v, out var n) && n >= 1 && n <= 4) return n;
        if (v.Contains("金")) return 4;
        if (v.Contains("银")) return 3;
        if (v.Contains("铜")) return 2;
        if (v.Contains("注册")) return 1;
        return 0;
    }
}

<div class="page-header">
    <h4><i class="fas fa-pen"></i> 信息纠错审核</h4>
    <p class="text-muted">用户对轴承信息的纠错建议，可查看并处理每条纠错记录</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "pending" ? "active" : "")" asp-action="Index" asp-route-status="pending">待审核</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "approved" ? "active" : "")" asp-action="Index" asp-route-status="approved">已通过</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "rejected" ? "active" : "")" asp-action="Index" asp-route-status="rejected">已拒绝</a>
    </li>
</ul>

<div class="card">
    <div class="card-body p-0">
        @if (!items.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-check-circle fa-3x mb-3"></i>
                <p>暂无纠错数据</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>目标</th>
                            <th>字段</th>
                            <th>纠错对比（原值 → 应改为）</th>
                            <th>理由</th>
                            <th>提交人</th>
                            <th style="width:140px">时间</th>
                            @if (currentStatus == "pending")
                            {
                                <th style="width:150px">操作</th>
                            }
                            else
                            {
                                <th style="width:160px">审核意见</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@item.TargetType</span> @item.TargetDisplay</td>
                                <td>@item.FieldDisplayName</td>
                                <td>
                                    <span class="text-muted text-decoration-line-through">@(string.IsNullOrWhiteSpace(item.OriginalValue) ? "（空）" : item.OriginalValue)</span>
                                    <i class="fas fa-arrow-right mx-1 text-muted"></i>
                                    <span class="text-success fw-bold">@item.SuggestedValue</span>
                                </td>
                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(item.Reason) ? "-" : item.Reason)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.SubmitterName) ? "-" : item.SubmitterName)</td>
                                <td class="text-muted small" data-utc="@BdTimeRaw(item.SubmittedAt)">@BdTimeRaw(item.SubmittedAt)</td>
                                @if (currentStatus == "pending")
                                {
                                    <td>
                                        @* 改动说明（v1.47.1 卡级申诉联动）：牌级类纠错不自动改级，给「去调级」直达入口（预填商家与申诉理由） *@
                                        @if (string.Equals(item.TargetType, "Merchant", StringComparison.OrdinalIgnoreCase)
                                             && string.Equals(item.FieldName, "merchantGrade", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <a class="btn btn-sm btn-outline-primary"
                                               asp-controller="MerchantGrade" asp-action="Index"
                                               asp-route-merchantId="@item.TargetId"
                                               asp-route-merchantName="@item.TargetDisplay"
                                               asp-route-reason="@item.Reason"
                                               asp-route-grade="@CorrectionGradeValue(item.SuggestedValue)">去调级</a>
                                        }
                                        <button class="btn btn-sm btn-success btn-approve"
                                                data-id="@item.Id"
                                                data-field="@item.FieldName">采纳</button>
                                        <button class="btn btn-sm btn-outline-danger btn-reject" data-id="@item.Id">驳回</button>
                                    </td>
                                }
                                else
                                {
                                    <td class="small">@(string.IsNullOrWhiteSpace(item.ReviewComment) ? "-" : item.ReviewComment)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">共 @totalPages 页 / @totalCount 条</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(page <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(1)">首页</a>
                                </li>
                                <li class="page-item @(page <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(page - 1)">&laquo;</a>
                                </li>
                                @{
                                    var rs = Math.Max(1, page - 2);
                                    var re = Math.Min(totalPages, page + 2);
                                }
                                @if (rs > 1) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                                @for (var i = rs; i <= re; i++)
                                {
                                    <li class="page-item @(i == page ? "active" : "")">
                                        <a class="page-link" href="@PageUrl(i)">@i</a>
                                    </li>
                                }
                                @if (re < totalPages) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(page + 1)">&raquo;</a>
                                </li>
                                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(totalPages)">尾页</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        }
    </div>
</div>
@section Scripts {
<script>
    // 纠错审批操作（v1.23.0）：采纳=showConfirm 确认+POST Approve；驳回=showPrompt 必填原因+POST Reject。
    // 409 冲突（他人已处理）提示后自动刷新列表，与入驻审批交互对齐；弹窗统一走 dialogs.js（Promise 风格）
    $(function () {
        $('.btn-approve').on('click', function (e) {
            e.preventDefault();
            var id = $(this).data('id');
            // 改动说明（v1.47.1 卡级申诉联动）：牌级类纠错采纳不改级（避免纠错审核成为绕开治理的改级后门），
            //   文案先说清，管理员据需另走「去调级」并二次确认
            var isGrade = $(this).data('field') === 'merchantGrade';
            var msg = isGrade
                ? '该条为商家牌级申诉：采纳只记录处理结果并通知提交人，不会自动调整牌级；如需改级请使用「去调级」。确认采纳？'
                : '采纳后将自动更新该条信息并通知提交人，确认？';
            showConfirm({ title: '采纳纠错', message: msg }).then(function (ok) {
                if (!ok) return;
                $.post('@Url.Action("Approve")', { id: id })
                    .done(function (r) {
                        if (r.success) { showToast('success', r.message); setTimeout(function () { location.reload(); }, 800); }
                        else { showToast(r.conflict ? 'warning' : 'error', r.message); if (r.conflict) setTimeout(function () { location.reload(); }, 1200); }
                    })
                    .fail(function () { showToast('error', '请求失败'); });
            });
        });

        $('.btn-reject').on('click', function (e) {
            e.preventDefault();
            var id = $(this).data('id');
            showPrompt({ title: '驳回纠错', message: '请填写驳回原因（将通过站内信通知提交人）', required: true }).then(function (reason) {
                if (!reason) return;
                $.post('@Url.Action("Reject")', { id: id, comment: reason })
                    .done(function (r) {
                        if (r.success) { showToast('success', r.message); setTimeout(function () { location.reload(); }, 800); }
                        else { showToast(r.conflict ? 'warning' : 'error', r.message); if (r.conflict) setTimeout(function () { location.reload(); }, 1200); }
                    })
                    .fail(function () { showToast('error', '请求失败'); });
            });
        });
    });
</script>
}