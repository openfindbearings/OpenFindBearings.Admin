@{
    ViewData["Title"] = "数据爬虫";
}

<!-- 爬虫运行态卡片（从 Sync 页面迁移） -->
<div class="row mb-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">爬虫运行状态</h6></div>
            <div class="card-body">
                <span class="badge" id="badge-Crawler">--</span>
                <div class="small text-muted mt-2" id="desc-Crawler">--</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">调度策略</h6></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><th style="width:140px">调度方式</th><td>K8s CronJob 定时任务</td></tr>
                        <tr><th>执行时间</th><td>每日 06:00（北京时间）自动触发</td></tr>
                        <tr><th>超时限制</th><td>单次运行最长 4 小时，超时自动中止，次日续跑</td></tr>
                        <tr><th>数据流向</th><td>爬虫 → db_raw → Sync ETL → db_api</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 爬虫接入数据源 -->
<div class="card mb-3">
    <div class="card-header"><h6 class="mb-0">接入数据源</h6></div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>数据源</th><th>爬虫名称</th><th>最近抓取</th><th>状态</th></tr></thead>
            <tbody id="crawlerTableBody">
                <tr><td colspan="4" class="text-center text-muted py-4">加载中...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function fmtTime(v) {
        if (!v) return "-";
        var s = (typeof v === "string" && !/Z$|[+-]\d{2}:\d{2}$/.test(v)) ? v + "Z" : v;
        var d = new Date(s);
        if (isNaN(d)) return "-";
        // 手动加 8 小时偏移，按 UTC+8（北京时间）显示
        var utcMs = d.getTime() + (8 * 60 * 60 * 1000);
        var bd = new Date(utcMs);
        var y = bd.getUTCFullYear();
        var m = String(bd.getUTCMonth() + 1).padStart(2, "0");
        var day = String(bd.getUTCDate()).padStart(2, "0");
        var h = String(bd.getUTCHours()).padStart(2, "0");
        var min = String(bd.getUTCMinutes()).padStart(2, "0");
        return y + "/" + m + "/" + day + " " + h + ":" + min;
    }

    // 全局缓存 summary 数据，供数据源表使用
    var crawlerSummaryData = null;

    function renderCrawlerStatus(crawler) {
        var badge = document.getElementById("badge-Crawler");
        var desc = document.getElementById("desc-Crawler");
        if (!badge || !desc) return;
        if (!crawler) {
            badge.className = "badge bg-secondary";
            badge.textContent = "无数据";
            desc.textContent = "爬虫可能尚未运行或 Sync 服务离线";
            return;
        }
        if (crawler.hasStuckProcessing) {
            badge.className = "badge bg-danger";
            badge.textContent = "存在中断";
        } else {
            badge.className = "badge bg-success";
            badge.textContent = "正常";
        }
        var total = Object.values(crawler.bearingStatusCounts || {}).reduce(function(a,b){return a+b;}, 0)
            + Object.values(crawler.merchantStatusCounts || {}).reduce(function(a,b){return a+b;}, 0)
            + Object.values(crawler.merchantBearingStatusCounts || {}).reduce(function(a,b){return a+b;}, 0);
        desc.innerHTML = "最近抓取: " + fmtTime(crawler.lastCrawlAt)
            + "<br/>记录总数: " + total
            + (crawler.hasStuckProcessing ? "<br/><span class='text-danger'>存在 processing 卡住记录</span>" : "");
    }

    function unwrap(resp) {
        return resp && resp.data !== undefined ? resp.data : resp;
    }

    // 加载爬虫运行态（从 /api/proxy/etl/summary 的 Crawler 字段）
    async function loadCrawlerStatus() {
        try {
            var r = await fetch("/api/proxy/etl/summary");
            if (!r.ok) return;
            var j = await r.json();
            var summary = unwrap(j);
            if (summary && summary.crawler) {
                crawlerSummaryData = summary.crawler;
                renderCrawlerStatus(summary.crawler);
                // 如果数据源表已加载，刷新最近抓取列
                refreshDataSourceLastCrawl();
            }
        } catch (e) { /* 忽略 */ }
    }

    // 用 summary 数据刷新数据源表的「最近抓取」列
    function refreshDataSourceLastCrawl() {
        if (!crawlerSummaryData) return;
        var lastCrawl = crawlerSummaryData.lastCrawlAt;
        var cells = document.querySelectorAll("#crawlerTableBody td.last-crawl");
        cells.forEach(function (cell) {
            cell.textContent = lastCrawl ? fmtTime(lastCrawl) : "-";
        });
    }

    // 加载数据源列表（从 Sync /api/datasources）
    function loadDataSourceList() {
        fetch('/Home/DataSources')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var rows = data && data.length ? data : [];
                var tbody = document.getElementById('crawlerTableBody');
                if (rows.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-4">暂未接入爬虫数据源</td></tr>';
                    return;
                }
                var html = '';
                rows.forEach(function (item) {
                    var lastCrawl = (crawlerSummaryData && crawlerSummaryData.lastCrawlAt) ? fmtTime(crawlerSummaryData.lastCrawlAt) : "-";
                    var statusBadge = crawlerSummaryData
                        ? (crawlerSummaryData.hasStuckProcessing
                            ? '<span class="badge bg-danger">中断</span>'
                            : '<span class="badge bg-success">正常</span>')
                        : '<span class="badge bg-secondary">--</span>';
                    html += '<tr><td>' + (item.name || '-') + '</td><td>' + (item.displayName || '-') + '</td><td class="last-crawl">' + lastCrawl + '</td><td>' + statusBadge + '</td></tr>';
                });
                tbody.innerHTML = html;
            })
            .catch(function () {
                document.getElementById('crawlerTableBody').innerHTML =
                    '<tr><td colspan="4" class="text-center text-muted py-4">加载失败，Sync 服务可能离线</td></tr>';
            });
    }

    // 首屏加载 + 轮询（先加载 summary 获取 lastCrawlAt，再加载数据源列表）
    loadCrawlerStatus().then(function () { loadDataSourceList(); });
    setInterval(function () { loadCrawlerStatus().then(function () { refreshDataSourceLastCrawl(); }); }, 30000);
</script>
}
