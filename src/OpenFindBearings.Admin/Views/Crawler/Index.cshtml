@{
    ViewData["Title"] = "数据爬虫";
}

<div class="card">
    <div class="card-header"><h6 class="mb-0">爬虫接入情况</h6></div>
    <div class="card-body p-0">
        <table class="table table-hover">
            <thead><tr><th>数据源</th><th>爬虫名称</th></tr></thead>
            <tbody id="crawlerTableBody">
                <tr><td colspan="2" class="text-center text-muted py-4">加载中...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header"><h6 class="mb-0">调度策略</h6></div>
    <div class="card-body">
        <table class="table table-sm mb-0">
            <tbody>
                <tr>
                    <th style="width:180px">调度方式</th>
                    <td>K8s CronJob 定时任务</td>
                </tr>
                <tr>
                    <th>执行时间</th>
                    <td>每晚 22:00（UTC / 北京时间次日 06:00）自动触发</td>
                </tr>
                <tr>
                    <th>超时限制</th>
                    <td>单次运行最长 4 小时，超时自动中止，次日续跑</td>
                </tr>
                <tr>
                    <th>说明</th>
                    <td>爬虫统一按上述策略调度，数据写入原始库（db_raw），经 Sync ETL 流程处理后进入业务库</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
(function () {
    fetch('/Home/DataSources')
        .then(function (r) { return r.json(); })
        .then(function (data) {
            var rows = data && data.length ? data : [];
            var tbody = document.getElementById('crawlerTableBody');
            if (rows.length === 0) {
                tbody.innerHTML = '<tr><td colspan="2" class="text-center text-muted py-4">暂未接入爬虫数据源</td></tr>';
                return;
            }
            var html = '';
            rows.forEach(function (item) {
                html += '<tr><td>' + (item.name || '-') + '</td><td>' + (item.displayName || '-') + '</td></tr>';
            });
            tbody.innerHTML = html;
        })
        .catch(function () {
            document.getElementById('crawlerTableBody').innerHTML =
                '<tr><td colspan="2" class="text-center text-muted py-4">加载失败，Sync 服务可能离线</td></tr>';
        });
})();
</script>
}
