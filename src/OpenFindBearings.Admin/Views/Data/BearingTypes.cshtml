@model TypeListViewModel
@{
    ViewData["Title"] = "类型列表";
    string PageUrl(int p) => $"?page={p}&pageSize={Model.PageSize}&search={Uri.EscapeDataString(Model.Search ?? "")}&includeDeleted={Model.IncludeDeleted.ToString().ToLower()}";
}

<div class="page-header">
    <div>
        <h4><i class="fas fa-shapes"></i> 类型列表</h4>
        <p>共 @Model.TotalCount 条；维护平台轴承类型字典。</p>
    </div>
    <div class="page-actions">
        @if (PanelPerms.Has(User, "type.create"))
        {
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#typeModal" onclick="openCreateType()">
            <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">新建</span>
        </button>
        }
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <form class="filter-bar" method="get">
            <input type="text" name="search" value="@Model.Search" class="form-control filter-search" placeholder="搜索类型..." />
            <div class="form-check filter-check">
                <input class="form-check-input" type="checkbox" name="includeDeleted" value="true" id="includeDeleted" @(Model.IncludeDeleted ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label" for="includeDeleted">显示已删除</label>
            </div>
            <button class="btn btn-primary"><i class="fas fa-search"></i> 查询</button>
        </form>
        <div class="table-responsive"><table class="table table-hover">
            <thead><tr><th>编码</th><th>名称</th><th>英文名</th><th>典型前缀</th><th>结构</th><th>轴承数</th><th>操作</th></tr></thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Name</td>
                            <td>@(item.EnglishName ?? "-")</td>
                            <td>@(item.TypicalPrefixes ?? "-")</td>
                            <td>@(item.IsSeparable == true ? "可分离" : item.IsSeparable == false ? "不可分离" : "-")</td>
                            <td>@item.BearingCount</td>
                            <td>
                                @if (PanelPerms.Has(User, "type.edit"))
                                {
                                <button class="btn btn-sm btn-outline-primary" onclick='openEditType(@Html.Raw(Json.Serialize(item)))' title="编辑"><i class="fas fa-pen"></i><span class="d-none d-sm-inline">编辑</span></button>
                                }
                                @if (Model.IncludeDeleted)
                                {
                                    @if (PanelPerms.Has(User, "data.restore"))
                                    {
                                    <form method="post" asp-action="RestoreBearingType" asp-route-id="@item.Id" class="d-inline" data-confirm="确定要恢复该类型吗？">
                                        <button class="btn btn-sm btn-outline-success" title="恢复"><i class="fas fa-rotate-left"></i><span class="d-none d-sm-inline">恢复</span></button>
                                    </form>
                                    }
                                    @if (PanelPerms.Has(User, "data.harddelete"))
                                    {
                                    <form method="post" asp-action="HardDeleteBearingType" asp-route-id="@item.Id" class="d-inline" data-confirm="此操作不可恢复，确定要彻底删除该类型吗？" data-confirm-danger>
                                        <button class="btn btn-sm btn-outline-danger" title="彻底删除"><i class="fas fa-fire"></i><span class="d-none d-sm-inline">彻底删除</span></button>
                                    </form>
                                    }
                                }
                                else
                                {
                                    @if (PanelPerms.Has(User, "type.delete"))
                                    {
                                    <form method="post" asp-action="DeleteBearingType" asp-route-id="@item.Id" class="d-inline" data-confirm="确定要删除该类型吗？" data-confirm-danger>
                                        <button class="btn btn-sm btn-outline-danger" title="删除"><i class="fas fa-trash"></i><span class="d-none d-sm-inline">删除</span></button>
                                    </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">暂无数据</td></tr>
                }
            </tbody>
        </table></div>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">共 @Model.TotalPages 页 / @Model.TotalCount 条</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(1)">首页</a>
                        </li>
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.Page - 1)">&laquo;</a>
                        </li>
                        @{
                            var rangeStart = Math.Max(1, Model.Page - 2);
                            var rangeEnd = Math.Min(Model.TotalPages, Model.Page + 2);
                            if (rangeStart > 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            for (var i = rangeStart; i <= rangeEnd; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@PageUrl(i)">@i</a>
                                </li>
                            }
                            if (rangeEnd < Model.TotalPages)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.Page + 1)">&raquo;</a>
                        </li>
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.TotalPages)">尾页</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<!-- 新建/编辑类型弹窗 -->
<div class="modal fade" id="typeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" id="typeForm">
                <div class="modal-header">
                    <h6 class="modal-title" id="typeModalTitle">新建类型</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="typeId" />
                    <div class="mb-3">
                        <label class="form-label">编码 <span class="text-danger">*</span></label>
                        <input type="text" name="code" id="typeCode" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">名称 <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="typeName" class="form-control" required />
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">英文名称</label>
                            <input type="text" name="englishName" id="typeEnglishName" class="form-control" maxlength="100" placeholder="如 Deep Groove Ball Bearing" />
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">典型型号前缀</label>
                            <input type="text" name="typicalPrefixes" id="typeTypicalPrefixes" class="form-control" maxlength="100" placeholder="如 60/62/63/68/69" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">描述</label>
                            <textarea name="description" id="typeDescription" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">结构特点</label>
                            <textarea name="structureFeatures" id="typeStructureFeatures" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">载荷特性</label>
                            <textarea name="loadCharacteristics" id="typeLoadCharacteristics" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">主要应用领域</label>
                            <input type="text" name="mainApplications" id="typeMainApplications" class="form-control" maxlength="200" placeholder="如 电机、家电、汽车" />
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">结构示意图地址</label>
                            <input type="text" name="imageUrl" id="typeImageUrl" class="form-control" maxlength="300" />
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">结构是否可分离</label>
                            <select name="isSeparable" id="typeIsSeparable" class="form-select">
                                <option value="">未填写</option>
                                <option value="true">可分离（如圆锥滚子轴承内外圈可分开安装）</option>
                                <option value="false">不可分离</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openCreateType() {
    document.getElementById('typeModalTitle').textContent = '新建类型';
    document.getElementById('typeForm').action = '@Url.Action("CreateBearingType")';
    document.getElementById('typeId').value = '';
    document.getElementById('typeCode').value = '';
    document.getElementById('typeCode').removeAttribute('readonly');
    document.getElementById('typeName').value = '';
    document.getElementById('typeDescription').value = '';
    // 改动说明（类型资料完善）：新建时清空全部档案字段
    document.getElementById('typeEnglishName').value = '';
    document.getElementById('typeTypicalPrefixes').value = '';
    document.getElementById('typeStructureFeatures').value = '';
    document.getElementById('typeLoadCharacteristics').value = '';
    document.getElementById('typeMainApplications').value = '';
    document.getElementById('typeImageUrl').value = '';
    document.getElementById('typeIsSeparable').value = '';
}
function openEditType(item) {
    document.getElementById('typeModalTitle').textContent = '编辑类型';
    document.getElementById('typeForm').action = '@Url.Action("EditBearingType")';
    document.getElementById('typeId').value = item.id;
    document.getElementById('typeCode').value = item.code;
    document.getElementById('typeCode').setAttribute('readonly', true);
    document.getElementById('typeName').value = item.name;
    document.getElementById('typeDescription').value = item.description || '';
    // 改动说明（类型资料完善）：编辑时回填档案字段
    document.getElementById('typeEnglishName').value = item.englishName || '';
    document.getElementById('typeTypicalPrefixes').value = item.typicalPrefixes || '';
    document.getElementById('typeStructureFeatures').value = item.structureFeatures || '';
    document.getElementById('typeLoadCharacteristics').value = item.loadCharacteristics || '';
    document.getElementById('typeMainApplications').value = item.mainApplications || '';
    document.getElementById('typeImageUrl').value = item.imageUrl || '';
    document.getElementById('typeIsSeparable').value = item.isSeparable === true ? 'true' : item.isSeparable === false ? 'false' : '';
    new bootstrap.Modal(document.getElementById('typeModal')).show();
}
</script>
}
