@model BearingListViewModel
@functions
{
    // 改动说明（v1.40.0 创建时间列）：输出 UTC ISO 串，交全局 data-utc 转换器按浏览器时区渲染
    string TimeRaw(DateTime? dt) => dt.HasValue ? dt.Value.ToString("yyyy-MM-ddTHH:mm:ssZ") : "-";
}
@{
    ViewData["Title"] = "轴承列表";
    // 改动说明（v1.40.0 下钻筛选）：分页/查询保留搜索、已删除、创建时间区间与来源
    string FilterQuery() => $"&search={Uri.EscapeDataString(Model.Search ?? "")}&includeDeleted={Model.IncludeDeleted.ToString().ToLower()}"
        + (!string.IsNullOrWhiteSpace(Model.DateFrom) ? $"&dateFrom={Uri.EscapeDataString(Model.DateFrom)}" : "")
        + (!string.IsNullOrWhiteSpace(Model.DateTo) ? $"&dateTo={Uri.EscapeDataString(Model.DateTo)}" : "")
        + (!string.IsNullOrWhiteSpace(Model.SourceFilter) ? $"&sourceFilter={Model.SourceFilter}" : "");
    string PageUrl(int p) => $"?page={p}&pageSize={Model.PageSize}{FilterQuery()}";
}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h6 class="mb-0">轴承列表 <small class="text-muted">(@Model.TotalCount 条)</small></h6>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (PanelPerms.Has(User, "bearing.create"))
            {
            @* 改动说明（v2.13.2 死链修复）：原 target=#bearingModal（不存在）且 onclick=openCreateBearing()（未定义），
   点击无反应；真实模态为 #createBearingModal *@
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createBearingModal">
                <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">新建</span>
            </button>
            }
            <form class="d-flex flex-wrap gap-2 align-items-center" method="get">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="搜索型号..." style="min-width:140px" />
                @* 改动说明（v1.40.0 下钻筛选）：创建时间区间 + 来源（互联网/非互联网），供仪表盘"新增"柱下钻核对 *@
                <input type="date" name="dateFrom" value="@Model.DateFrom" class="form-control form-control-sm" style="width:150px" title="创建起始日期（含）" />
                <span class="text-muted small">~</span>
                <input type="date" name="dateTo" value="@Model.DateTo" class="form-control form-control-sm" style="width:150px" title="创建截止日期（含）" />
                <select name="sourceFilter" class="form-select form-select-sm" style="width:130px" title="来源">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.SourceFilter) ? "selected" : null)">全部来源</option>
                    <option value="internet" selected="@(Model.SourceFilter == "internet" ? "selected" : null)">仅互联网</option>
                    <option value="noninternet" selected="@(Model.SourceFilter == "noninternet" ? "selected" : null)">仅非互联网</option>
                </select>
                <div class="form-check d-none d-sm-block" style="white-space:nowrap">
                    <input class="form-check-input" type="checkbox" name="includeDeleted" value="true" id="includeDeleted" @(Model.IncludeDeleted ? "checked" : "") />
                    <label class="form-check-label" for="includeDeleted">显示已删除</label>
                </div>
                <button class="btn btn-primary"><i class="fas fa-search"></i></button>
                @if (!string.IsNullOrWhiteSpace(Model.DateFrom) || !string.IsNullOrWhiteSpace(Model.DateTo) || !string.IsNullOrWhiteSpace(Model.SourceFilter))
                {
                    <a class="btn btn-outline-secondary" href="?search=@Uri.EscapeDataString(Model.Search ?? "")&includeDeleted=@Model.IncludeDeleted.ToString().ToLower()" title="清除时间/来源筛选"><i class="fas fa-xmark"></i></a>
                }
            </form>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive"><table class="table table-hover">
            <thead><tr><th>型号</th><th>旧型号</th><th>品牌</th><th>类型</th><th>英文名</th><th class="d-none d-md-table-cell">来源</th><th class="d-none d-md-table-cell">创建时间</th><th>操作</th></tr></thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.PartNumber</td>
                            <td>@(item.OldNumber ?? "-")</td>
                            <td>@(item.BrandName ?? "-")</td>
                            <td>@(item.BearingType ?? "-")</td>
                            <td>@(item.EnglishName ?? "-")</td>
                            @* 改动说明（v1.40.0 来源/创建时间列）：数据来源与创建时间（UTC 由全局 data-utc 渲染） *@
                            <td class="d-none d-md-table-cell">@(string.IsNullOrWhiteSpace(item.DataSource) ? "-" : item.DataSource)</td>
                            <td class="d-none d-md-table-cell text-nowrap text-muted small" data-utc="@TimeRaw(item.CreatedAt)">@TimeRaw(item.CreatedAt)</td>
                            <td>
                                @if (PanelPerms.Has(User, "bearing.edit"))
                                {
                                <button class="btn btn-sm btn-outline-primary" onclick='openEditBearing(@Html.Raw(Json.Serialize(item)))' title="编辑"><i class="fas fa-pen"></i><span class="d-none d-sm-inline">编辑</span></button>
                                }
                                <button class="btn btn-sm btn-outline-info btn-interchange" data-id="@item.Id" data-name="@item.PartNumber" title="替代品"><i class="fas fa-shuffle"></i><span class="d-none d-sm-inline">替代品</span></button>
                                <button class="btn btn-sm btn-outline-secondary btn-merchants" data-id="@item.Id" data-name="@item.PartNumber" title="在售商家"><i class="fas fa-store"></i><span class="d-none d-sm-inline">在售商家</span></button>
                                @if (Model.IncludeDeleted)
                                {
                                    @if (PanelPerms.Has(User, "data.restore"))
                                    {
                                    <form method="post" asp-action="RestoreBearing" asp-route-id="@item.Id" class="d-inline" data-confirm="确定要恢复该轴承吗？">
                                        <button class="btn btn-sm btn-outline-success" title="恢复"><i class="fas fa-rotate-left"></i><span class="d-none d-sm-inline">恢复</span></button>
                                    </form>
                                    }
                                    @if (PanelPerms.Has(User, "data.harddelete"))
                                    {
                                    <form method="post" asp-action="HardDeleteBearing" asp-route-id="@item.Id" class="d-inline" data-confirm="此操作不可恢复，确定要彻底删除该轴承吗？" data-confirm-danger>
                                        <button class="btn btn-sm btn-outline-danger" title="彻底删除"><i class="fas fa-fire"></i><span class="d-none d-sm-inline">彻底删除</span></button>
                                    </form>
                                    }
                                }
                                else
                                {
                                    @if (PanelPerms.Has(User, "bearing.delete"))
                                    {
                                    <form method="post" asp-action="DeleteBearing" asp-route-id="@item.Id" class="d-inline" data-confirm="确定要删除该轴承吗？" data-confirm-danger>
                                        <button class="btn btn-sm btn-outline-danger" title="删除"><i class="fas fa-trash"></i><span class="d-none d-sm-inline">删除</span></button>
                                    </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">暂无数据</td></tr>
                }
            </tbody>
        </table></div>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">共 @Model.TotalPages 页 / @Model.TotalCount 条</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(1)">首页</a>
                        </li>
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.Page - 1)">&laquo;</a>
                        </li>
                        @{
                            var rangeStart = Math.Max(1, Model.Page - 2);
                            var rangeEnd = Math.Min(Model.TotalPages, Model.Page + 2);
                            if (rangeStart > 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            for (var i = rangeStart; i <= rangeEnd; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@PageUrl(i)">@i</a>
                                </li>
                            }
                            if (rangeEnd < Model.TotalPages)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.Page + 1)">&raquo;</a>
                        </li>
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.TotalPages)">尾页</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<!-- 新建轴承弹窗 -->
<div class="modal fade" id="createBearingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="CreateBearing">
                <div class="modal-header">
                    <h6 class="modal-title">新建轴承</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">型号 <span class="text-danger">*</span></label>
                        <input type="text" name="partNumber" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">旧型号</label>
                        <input type="text" name="oldNumber" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">品牌</label>
                        <input type="text" name="brandName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">类型</label>
                        <input type="text" name="bearingType" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">描述</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 编辑轴承弹窗 -->
<div class="modal fade" id="editBearingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="EditBearing">
                <div class="modal-header">
                    <h6 class="modal-title">编辑轴承</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="bearingId" />
                    <div class="mb-3">
                        <label class="form-label">型号</label>
                        <input type="text" name="partNumber" id="bearingPartNumber" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">旧型号</label>
                        <input type="text" name="oldNumber" id="bearingOldNumber" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">品牌</label>
                        <input type="text" name="brandName" id="bearingBrandName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">类型</label>
                        <input type="text" name="bearingType" id="bearingBearingType" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">描述</label>
                        <textarea name="description" id="bearingDescription" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 替代品弹窗 -->
<div class="modal fade" id="interchangeModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h6 class="modal-title">替代品 - <span id="interchangeBearing"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body"><div class="table-responsive"><table class="modal-table"><thead><tr><th>类型</th><th>品牌</th><th>型号</th><th>备注</th></tr></thead><tbody id="interchangeBody"></tbody></table></div></div>
    </div></div>
</div>

<!-- 在售商家弹窗 -->
<div class="modal fade" id="merchantsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">在售商家 - <span id="merchantsBearing"></span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2 text-muted small">共 <span id="merchantsCount">0</span> 家在售商家</div>
                <div class="table-responsive"><table class="table table-sm table-hover">
                    <thead><tr><th>商家名称</th><th>状态</th></tr></thead>
                    <tbody id="merchantsBody"></tbody>
                </table></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openEditBearing(item) {
    document.getElementById('bearingId').value = item.id;
    document.getElementById('bearingPartNumber').value = item.partNumber || '';
    document.getElementById('bearingOldNumber').value = item.oldNumber || '';
    document.getElementById('bearingBrandName').value = item.brandName || '';
    document.getElementById('bearingBearingType').value = item.bearingType || '';
    document.getElementById('bearingDescription').value = item.description || '';
    new bootstrap.Modal(document.getElementById('editBearingModal')).show();
}
document.querySelectorAll('.btn-interchange').forEach(function(btn){
    btn.addEventListener('click',function(){
        var id=this.dataset.id, name=this.dataset.name;
        document.getElementById('interchangeBearing').textContent=name;
        document.getElementById('interchangeBody').innerHTML='<tr><td colspan="4">加载中...</td></tr>';
        new bootstrap.Modal(document.getElementById('interchangeModal')).show();
        fetch('/api/proxy/interchanges/'+id).then(function(r){return r.json()}).then(function(d){
            // v2.16.0：API 统一响应外层 {success,data}，替代品数组在 d.data；兼容旧裸数组返回
            var list = (d && d.data) ? d.data : (d || []);
            var h='';
            list.forEach(function(r){
                h+='<tr><td>'+(r.typeLabel||'-')+'</td><td>'+(r.brandName||'-')+'</td><td>'+(r.partNumber||'-')+'</td><td>'+(r.remarks||'-')+'</td></tr>';
            });
            document.getElementById('interchangeBody').innerHTML=h||'<tr><td colspan="4" class="text-center text-muted">无替代品</td></tr>';
        }).catch(function(){document.getElementById('interchangeBody').innerHTML='<tr><td colspan="4" class="text-center text-danger">加载失败</td></tr>';});
    });
});

// 在售商家：按轴承反查多家在售商家，点击商家行跳转到商家管理页并自动打开其“在售商品”弹窗
document.querySelectorAll('.btn-merchants').forEach(function(btn){
    btn.addEventListener('click',function(){
        var id=this.dataset.id, name=this.dataset.name;
        document.getElementById('merchantsBearing').textContent=name;
        document.getElementById('merchantsBody').innerHTML='<tr><td colspan="2">加载中...</td></tr>';
        new bootstrap.Modal(document.getElementById('merchantsModal')).show();
        fetch('/api/proxy/bearing-merchants/'+id+'?onlyOnSale=true&pageSize=50').then(function(r){return r.json()}).then(function(d){
            var data = d && d.data ? d.data : (d || {});
            var list = data.items || [];
            document.getElementById('merchantsCount').textContent = (data.totalCount != null) ? data.totalCount : list.length;
            var h='';
            list.forEach(function(m){
                var url='/Data/Merchants?merchantId='+encodeURIComponent(m.id)+'&search='+encodeURIComponent(m.name||'');
                h+='<tr style="cursor:pointer" onclick="location.href=\''+url+'\'"><td>'+(m.name||'-')+'</td><td>'+(m.isVerified?'已认证':'未认证')+'</td></tr>';
            });
            document.getElementById('merchantsBody').innerHTML=h||'<tr><td colspan="2" class="text-center text-muted">暂无在售商家</td></tr>';
        }).catch(function(){document.getElementById('merchantsBody').innerHTML='<tr><td colspan="2" class="text-center text-danger">加载失败</td></tr>';});
    });
});
</script>
}
