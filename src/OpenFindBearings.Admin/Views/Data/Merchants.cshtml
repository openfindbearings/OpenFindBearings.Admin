@model MerchantListViewModel
@{
    ViewData["Title"] = "商家列表";
    var vo = Model.VerifiedOnly;
    string PageUrl(int p) => $"?page={p}&pageSize={Model.PageSize}&search={Uri.EscapeDataString(Model.Search ?? "")}&verifiedOnly={vo ?? ""}";
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(vo == null ? "active" : "")" href="@Url.Action("Merchants", new { verifiedOnly = (string?)null, search = Model.Search, page = 1 })">全部</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(vo == "true" ? "active" : "")" href="@Url.Action("Merchants", new { verifiedOnly = "true", search = Model.Search, page = 1 })">已认证</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(vo == "false" ? "active" : "")" href="@Url.Action("Merchants", new { verifiedOnly = "false", search = Model.Search, page = 1 })">未认证</a>
    </li>
</ul>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">商家列表 <small class="text-muted">(@Model.TotalCount 条)</small></h6>
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createMerchantModal">
                <i class="fas fa-plus"></i> 新建
            </button>
            <button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                <i class="fas fa-file-excel"></i> Excel 导入
            </button>
            <form class="d-flex gap-2 align-items-center flex-nowrap" method="get">
                <input type="hidden" name="verifiedOnly" value="@vo" />
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="搜索商家..." style="min-width:140px" />
                <button class="btn btn-primary"><i class="fas fa-search"></i></button>
            </form>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover">
            <thead><tr><th>名称</th><th>英文名</th><th>公司</th><th>类型</th><th>联系人</th><th>电话</th><th>认证</th><th>操作</th></tr></thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@(item.EnglishName ?? "-")</td>
                            <td>@(item.CompanyName ?? "-")</td>
                            <td>@item.Type</td>
                            <td>@(item.ContactPerson ?? "-")</td>
                            <td>@(item.Phone ?? "-")</td>
                            <td>@(item.IsVerified ? "已认证" : "未认证")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" onclick='openEditMerchant(@Html.Raw(Json.Serialize(item)))'>编辑</button>
                                <button class="btn btn-sm btn-outline-info btn-on-sale" data-id="@item.Id" data-name="@item.Name">在售商品</button>
                                @if (Model.IncludeDeleted)
                                {
                                    <form method="post" asp-action="RestoreMerchant" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('确定要恢复该商家吗？')">
                                        <button class="btn btn-sm btn-outline-success">恢复</button>
                                    </form>
                                    <form method="post" asp-action="HardDeleteMerchant" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('此操作不可恢复，确定要彻底删除该商家吗？')">
                                        <button class="btn btn-sm btn-outline-danger">彻底删除</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="DeleteMerchant" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('确定要删除该商家吗？')">
                                        <button class="btn btn-sm btn-outline-danger">删除</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">暂无数据</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">共 @Model.TotalPages 页 / @Model.TotalCount 条</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(1)">首页</a>
                        </li>
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.Page - 1)">&laquo;</a>
                        </li>
                        @{
                            var rangeStart = Math.Max(1, Model.Page - 2);
                            var rangeEnd = Math.Min(Model.TotalPages, Model.Page + 2);
                            if (rangeStart > 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            for (var i = rangeStart; i <= rangeEnd; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@PageUrl(i)">@i</a>
                                </li>
                            }
                            if (rangeEnd < Model.TotalPages)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.Page + 1)">&raquo;</a>
                        </li>
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.TotalPages)">尾页</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<!-- 新建商家弹窗 -->
<div class="modal fade" id="createMerchantModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="CreateMerchant">
                <div class="modal-header">
                    <h6 class="modal-title">新建商家</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">名称 <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">公司全称</label>
                        <input type="text" name="companyName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">英文名</label>
                        <input type="text" name="englishName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">联系人</label>
                        <input type="text" name="contactPerson" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">电话</label>
                        <input type="text" name="phone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">邮箱</label>
                        <input type="email" name="email" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">地址</label>
                        <textarea name="address" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 编辑商家弹窗 -->
<div class="modal fade" id="editMerchantModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="EditMerchant">
                <div class="modal-header">
                    <h6 class="modal-title">编辑商家</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="merchantId" />
                    <div class="mb-3">
                        <label class="form-label">名称</label>
                        <input type="text" name="name" id="merchantName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">公司全称</label>
                        <input type="text" name="companyName" id="merchantCompanyName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">英文名</label>
                        <input type="text" name="englishName" id="merchantEnglishName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">联系人</label>
                        <input type="text" name="contactPerson" id="merchantContact" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">电话</label>
                        <input type="text" name="phone" id="merchantPhone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">邮箱</label>
                        <input type="email" name="email" id="merchantEmail" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">地址</label>
                        <textarea name="address" id="merchantAddress" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 在售商品弹窗 -->
<div class="modal fade" id="onSaleModal" tabindex="-1">
    <div class="modal-dialog modal-xl"><div class="modal-content">
        <div class="modal-header"><h6 class="modal-title">在售商品 - <span id="onSaleMerchant"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body p-0">
            <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2">
                <small class="text-muted" id="onSaleTotal"></small>
                <div style="width:240px"><input type="text" class="form-control form-control-sm" id="onSaleSearch" placeholder="搜索型号/曾用代号/品牌..."></div>
            </div>
            <div style="max-height:55vh;overflow-y:auto">
                <table class="modal-table"><thead class="sticky-thead"><tr><th>型号</th><th>曾用代号</th><th>类型</th><th>尺寸</th><th>品牌</th><th>状态</th></tr></thead><tbody id="onSaleBody"></tbody></table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-3 py-2" id="onSalePager" style="display:none!important"></div>
        </div>
    </div></div>
</div>

<!-- Excel 批量导入弹窗 -->
<div class="modal fade" id="importExcelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="importExcelForm" enctype="multipart/form-data">
                <div class="modal-header">
                    <h6 class="modal-title">Excel 批量导入在售轴承</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">上传 Excel 文件，系统将自动解析并导入在售轴承数据。</p>
                    <div class="mb-3">
                        <label class="form-label">选择文件 <span class="text-danger">*</span></label>
                        <input type="file" name="file" id="importExcelFile" class="form-control" accept=".xlsx,.xls" required />
                    </div>
                    <div class="mb-3">
                        <a href="/api/proxy/excel/template" class="btn btn-outline-secondary btn-sm" target="_blank">
                            <i class="fas fa-download"></i> 下载导入模板
                        </a>
                    </div>
                    <div id="importResult" class="d-none">
                        <div class="alert" id="importResultAlert"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="importExcelBtn">
                        <i class="fas fa-upload"></i> 开始导入
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openEditMerchant(item) {
    document.getElementById('merchantId').value = item.id;
    document.getElementById('merchantName').value = item.name || '';
    document.getElementById('merchantCompanyName').value = item.companyName || '';
    document.getElementById('merchantEnglishName').value = item.englishName || '';
    document.getElementById('merchantContact').value = item.contactPerson || '';
    document.getElementById('merchantPhone').value = item.phone || '';
    document.getElementById('merchantEmail').value = item.email || '';
    document.getElementById('merchantAddress').value = item.address || '';
    new bootstrap.Modal(document.getElementById('editMerchantModal')).show();
}
var _onSaleAllItems=[];var _onSaleMerchantId='';
document.querySelectorAll('.btn-on-sale').forEach(function(btn){
    btn.addEventListener('click',function(){
        var id=this.dataset.id, name=this.dataset.name;
        _onSaleMerchantId=id;
        document.getElementById('onSaleMerchant').textContent=name;
        document.getElementById('onSaleBody').innerHTML='<tr><td colspan="6">加载中...</td></tr>';
        document.getElementById('onSalePager').style.display='none';
        document.getElementById('onSaleSearch').value='';
        new bootstrap.Modal(document.getElementById('onSaleModal')).show();
        loadOnSalePage(id, 1);
    });
});
document.getElementById('onSaleSearch').addEventListener('input',function(){
    var kw=this.value.trim().toLowerCase();
    if(!kw){renderOnSaleRows(_onSaleAllItems);return;}
    var filtered=_onSaleAllItems.filter(function(r){
        return (r.bearingPartNumber||'').toLowerCase().indexOf(kw)>=0||(r.bearingOldNumber||'').toLowerCase().indexOf(kw)>=0||(r.brandName||'').toLowerCase().indexOf(kw)>=0;
    });
    renderOnSaleRows(filtered);
});
function renderOnSaleRows(items){
    var h='';items.forEach(function(r){
        var statusText=r.isOnSale?'在售':'下架';
        h+='<tr><td>'+(r.bearingPartNumber||'-')+'</td><td>'+(r.bearingOldNumber||'-')+'</td><td>'+(r.bearingTypeName||'-')+'</td><td>'+(r.dimensions||'-')+'</td><td>'+(r.brandName||'-')+'</td><td>'+statusText+'</td></tr>';
    });
    document.getElementById('onSaleBody').innerHTML=h||'<tr><td colspan="6" class="text-center text-muted">无匹配结果</td></tr>';
}
function loadOnSalePage(merchantId, page) {
    var body = document.getElementById('onSaleBody');
    var pager = document.getElementById('onSalePager');
    body.innerHTML='<tr><td colspan="6">加载中...</td></tr>';
    pager.style.display='none';
    fetch('@Url.Action("GetMerchantBearings", new { id = "PLACEHOLDER" })'.replace('PLACEHOLDER', merchantId)+'?page='+page+'&pageSize=20')
    .then(function(r){return r.json()}).then(function(d){
        var data = d && d.data ? d.data : d || {};
        var items = data.items || data || [];
        var totalCount = data.totalCount || 0;
        var totalPages = data.totalPages || Math.ceil(totalCount/20) || 1;
        if (!Array.isArray(items)) items = [];
        _onSaleAllItems=items;
        var kw=document.getElementById('onSaleSearch').value.trim().toLowerCase();
        document.getElementById('onSaleTotal').textContent='共 '+totalCount+' 条记录'+(kw?' (当前页筛选)':'');
        if(kw){
            var filtered=items.filter(function(r){return(r.bearingPartNumber||'').toLowerCase().indexOf(kw)>=0||(r.bearingOldNumber||'').toLowerCase().indexOf(kw)>=0||(r.brandName||'').toLowerCase().indexOf(kw)>=0;});
            renderOnSaleRows(filtered);
        } else {
            renderOnSaleRows(items);
        }
        if (totalPages>1) {
            var ph='';ph+='<ul class="pagination pagination-sm mb-0">';
            ph+='<li class="page-item '+(page<=1?'disabled':'')+'"><a class="page-link" href="javascript:void(0)" onclick="loadOnSalePage(\''+merchantId+'\','+(page-1)+')">&laquo;</a></li>';
            var rs=Math.max(1,page-2),re=Math.min(totalPages,page+2);
            if(rs>1) ph+='<li class="page-item disabled"><span class="page-link">...</span></li>';
            for(var i=rs;i<=re;i++) ph+='<li class="page-item '+(i===page?'active':'')+'"><a class="page-link" href="javascript:void(0)" onclick="loadOnSalePage(\''+merchantId+'\','+i+')">'+i+'</a></li>';
            if(re<totalPages) ph+='<li class="page-item disabled"><span class="page-link">...</span></li>';
            ph+='<li class="page-item '+(page>=totalPages?'disabled':'')+'"><a class="page-link" href="javascript:void(0)" onclick="loadOnSalePage(\''+merchantId+'\','+(page+1)+')">&raquo;</a></li>';
            ph+='</ul>';
            pager.innerHTML=ph;
            pager.style.display='flex';
        } else { pager.style.display='none'; }
    }).catch(function(){body.innerHTML='<tr><td colspan="6" class="text-center text-danger">加载失败</td></tr>';});
}
document.getElementById('importExcelForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var fileInput = document.getElementById('importExcelFile');
    var btn = document.getElementById('importExcelBtn');
    var resultDiv = document.getElementById('importResult');
    var resultAlert = document.getElementById('importResultAlert');
    if (!fileInput.files.length) { alert('请选择文件'); return; }
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 导入中...';
    var formData = new FormData();
    formData.append('file', fileInput.files[0]);
    fetch('/api/proxy/excel/import-bearing', { method: 'POST', body: formData })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            resultDiv.classList.remove('d-none');
            if (d.success) {
                resultAlert.className = 'alert alert-success';
                resultAlert.textContent = d.message || '导入完成';
            } else {
                resultAlert.className = 'alert alert-danger';
                resultAlert.textContent = d.message || '导入失败';
            }
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-upload"></i> 开始导入';
        })
        .catch(function(err) {
            resultDiv.classList.remove('d-none');
            resultAlert.className = 'alert alert-danger';
            resultAlert.textContent = '请求失败: ' + err.message;
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-upload"></i> 开始导入';
        });
});

// 从轴承“在售商家”页跳转过来时，自动打开对应商家的“在售商品”弹窗（复用现有弹窗）
(function(){
    var params = new URLSearchParams(location.search);
    var mid = params.get('merchantId');
    if (!mid) return;
    var btn = document.querySelector('.btn-on-sale[data-id="' + mid + '"]');
    if (btn) btn.click();
})();
</script>
}
