@inject IConfiguration Configuration
@{
    ViewData["Title"] = "证照材料审核";
    var items = ViewBag.Items as IEnumerable<DocumentItemDto> ?? Enumerable.Empty<DocumentItemDto>();
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    string PageUrl(int p) => $"?page={p}";
    // 改动说明（v1.21.1）：材料文件由媒体服务反代 MinIO 直出，必须拼【公网】媒体基址——
    //   原拼 ApiUrls:OpenFindBearingsApi（K8s 内为集群内 svc 地址）浏览器不可达，"查看原件"点了报错
    var mediaBase = (Configuration["Media:PublicBaseUrl"] ?? "https://bff.515813.xyz/media").TrimEnd('/');
    // 改动说明：输出 UTC ISO 8601 字符串，由全局 data-utc JS 按浏览器时区显示
    string BdTimeRaw(DateTime? dt) => dt.HasValue ? dt.Value.ToString("yyyy-MM-ddTHH:mm:ssZ") : "-";
    string TypeBadge(int t) => t switch { 1 => "bg-info text-dark", 2 => "bg-primary", 3 => "bg-secondary", _ => "bg-light text-dark" };
}

<div class="page-header">
    <h4><i class="fas fa-folder-open"></i> 证照材料审核</h4>
    <p class="text-muted">入驻后的材料变更队列（换证/补授权书/厂房照）。随入驻申请提交的材料请在"入驻申请审批"抽屉内审结。</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card">
    <div class="card-body p-0">
        @if (!items.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-check-circle fa-3x mb-3"></i>
                <p>暂无待审核的证照材料</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>商家</th>
                            <th style="width:110px">材料类型</th>
                            <th style="width:110px">材料文件</th>
                            <th>提交人</th>
                            <th style="width:140px">提交时间</th>
                            <th style="width:170px">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>@item.MerchantName</td>
                                <td><span class="badge @TypeBadge(item.Type)">@item.TypeName</span></td>
                                <td>
                                    <a href="@mediaBase@item.FileUrl" target="_blank" rel="noopener" class="d-flex align-items-center gap-2 text-decoration-none">
                                        @if (item.FileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <i class="fas fa-file-pdf fa-lg text-danger"></i>
                                        }
                                        else
                                        {
                                            <img src="@mediaBase@item.FileUrl" alt="" style="width:48px;height:36px;object-fit:cover;border-radius:4px;border:1px solid rgba(255,255,255,.15)">
                                        }
                                        <span>查看原件</span>
                                    </a>
                                </td>
                                <td>@item.SubmitterName</td>
                                <td class="text-muted small" data-utc="@BdTimeRaw(item.SubmittedAt)">@BdTimeRaw(item.SubmittedAt)</td>
                                <td>
                                    @* v1.22.0：补确认框与全站审批口径统一（原直提易误点） *@
                                    <form method="post" asp-action="Approve" asp-route-id="@item.Id" class="d-inline" data-confirm="确认通过该条证照材料？" data-confirm-title="通过材料">
                                        <button class="btn btn-sm btn-success" title="通过"><i class="fas fa-check"></i><span class="d-none d-sm-inline">通过</span></button>
                                    </form>
                                    <form method="post" asp-action="Reject" asp-route-id="@item.Id" class="d-inline js-reject-form">
                                        <button class="btn btn-sm btn-outline-danger" title="拒绝"><i class="fas fa-times"></i><span class="d-none d-sm-inline">拒绝</span></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">共 @totalPages 页 / @totalCount 条</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(page <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(1)">首页</a>
                                </li>
                                <li class="page-item @(page <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(page - 1)">&laquo;</a>
                                </li>
                                @{
                                    var rs = Math.Max(1, page - 2);
                                    var re = Math.Min(totalPages, page + 2);
                                }
                                @if (rs > 1) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                                @for (var i = rs; i <= re; i++)
                                {
                                    <li class="page-item @(i == page ? "active" : "")">
                                        <a class="page-link" href="@PageUrl(i)">@i</a>
                                    </li>
                                }
                                @if (re < totalPages) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(page + 1)">&raquo;</a>
                                </li>
                                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(totalPages)">尾页</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        // 改动说明：拒绝动作升级为必填理由（旧版拒绝无原因，商户端无从知晓）；
        //   v1.22.0 原生 prompt 换统一 showPrompt（异步），确认后注入隐藏域再放行提交一次
        document.querySelectorAll('.js-reject-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (form.dataset.ofbConfirmed) { delete form.dataset.ofbConfirmed; return; }
                e.preventDefault();
                showPrompt({ title: '拒绝材料', message: '拒绝该材料的理由（将回传给商户）：', required: true, okText: '确认拒绝', danger: true })
                    .then(function (reason) {
                        if (reason === null) return;
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'reason';
                        input.value = reason;
                        form.appendChild(input);
                        form.dataset.ofbConfirmed = '1';
                        form.requestSubmit();
                    });
            });
        });
    </script>
}
