@using OpenFindBearings.Admin.Controllers
@using OpenFindBearings.Admin.Models.ViewModels
@{
    ViewData["Title"] = "仪表盘";
}

<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner"><h3 id="bearingCount">-</h3><p>轴承总数</p></div>
            <div class="icon"><i class="fas fa-cogs"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner"><h3 id="brandCount">-</h3><p>品牌数量</p></div>
            <div class="icon"><i class="fas fa-tag"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner"><h3 id="typeCount">-</h3><p>类型数量</p></div>
            <div class="icon"><i class="fas fa-layer-group"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner"><h3 id="merchantCount">-</h3><p>商家数量（已入驻/总数）</p></div>
            <div class="icon"><i class="fas fa-store"></i></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-secondary">
            <div class="inner"><h3 id="syncPendingCount">-</h3><p>同步数据待审核</p></div>
            <div class="icon"><i class="fas fa-sync"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-secondary">
            <div class="inner"><h3 id="correctionPendingCount">-</h3><p>信息纠错待审核</p></div>
            <div class="icon"><i class="fas fa-pen"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-secondary">
            <div class="inner"><h3 id="licensePendingCount">-</h3><p>营业执照待审核</p></div>
            <div class="icon"><i class="fas fa-file-alt"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-secondary">
            <div class="inner"><h3 id="merchantApplicationPendingCount">-</h3><p>入驻申请待审批</p></div>
            <div class="icon"><i class="fas fa-user-check"></i></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">今日 / 本周 / 本月新增</h6></div>
            <div class="card-body">
                <canvas id="trendChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">品牌 Top10</h6></div>
            <div class="card-body" id="topBrandsChart"></div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h6 class="mb-0">服务状态</h6></div>
    <div class="card-body p-0">
        <table class="table" id="serviceTable">
            <thead><tr><th>服务</th><th>状态</th><th>详情</th></tr></thead>
            <tbody>
                <tr><td>API</td><td><span class="badge bg-secondary">检测中</span></td><td>-</td></tr>
                <tr><td>Sync</td><td><span class="badge bg-secondary">检测中</span></td><td>-</td></tr>
                <tr><td>Identity</td><td><span class="badge bg-secondary">检测中</span></td><td>-</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function () {
    fetch('/Home/DashboardStats')
        .then(function(r){return r.json()})
        .then(function(d){
            var data = d.data || d;
            var b=data.bearings||{};var m=data.merchants||{};var c=data.corrections||{};
            var br=data.brands||{};var tp=data.types||{};
            var sp=data.syncPendingReviews||{};

            var el=document.getElementById('bearingCount');if(el)el.textContent=b.totalCount??'-';
            el=document.getElementById('brandCount');if(el)el.textContent=br.totalCount??'-';
            el=document.getElementById('typeCount');if(el)el.textContent=tp.totalCount??'-';
            el=document.getElementById('merchantCount');if(el)el.textContent=(m.verifiedCount??'-')+'/'+(m.totalCount??'-');

            el=document.getElementById('syncPendingCount');if(el)el.textContent=(sp.brandCount||0)+(sp.typeCount||0)+(sp.bearingCount||0)+(sp.merchantCount||0);
            el=document.getElementById('correctionPendingCount');if(el)el.textContent=c.pendingCount??'-';
            el=document.getElementById('licensePendingCount');if(el)el.textContent=(data.pending||{}).pendingLicenses??'-';
            el=document.getElementById('merchantApplicationPendingCount');if(el)el.textContent=m.pendingApplicationCount??'-';

            try {
                var trendCanvas=document.getElementById('trendChart');
                if(trendCanvas&&typeof Chart!=='undefined'){
                    new Chart(trendCanvas,{
                        type:'bar',
                        data:{
                            labels:['今日','本周','本月'],
                            datasets:[{
                                label:'轴承',
                                data:[b.todayAdded||0,b.thisWeekAdded||0,b.thisMonthAdded||0],
                                backgroundColor:'rgba(23,162,184,.7)'
                            },{
                                label:'商家',
                                data:[m.todayRegistered||0,m.totalCount?Math.round(m.totalCount/30):0,0],
                                backgroundColor:'rgba(255,193,7,.7)'
                            }]
                        },
                        options:{
                            responsive:true,
                            plugins:{legend:{position:'bottom'}},
                            scales:{y:{beginAtZero:true}}
                        }
                    });
                }
            } catch(e) {}

            try {
                var brandsDiv=document.getElementById('topBrandsChart');
                if(brandsDiv&&b.topBrands&&b.topBrands.length){
                    var list='<ul class="list-group list-group-flush">';
                    b.topBrands.slice(0,10).forEach(function(x){
                        list+='<li class="list-group-item d-flex justify-content-between align-items-center">'+(x.brandName||'未知')+'<span class="badge bg-info rounded-pill">'+x.count+'</span></li>';
                    });
                    list+='</ul>';
                    brandsDiv.innerHTML=list;
                }
            } catch(e) {}
        })
        .catch(function(e){
            console.error('DashboardStats 渲染异常', e);
            ['bearingCount','brandCount','typeCount','merchantCount',
             'syncPendingCount','correctionPendingCount','licensePendingCount','merchantApplicationPendingCount'].forEach(function(id){
                var el=document.getElementById(id);if(el)el.textContent='N/A';
            });
        });
    fetch('/Home/Status')
        .then(function(r){return r.json()})
        .then(function(data){
            var tbody=document.querySelector('#serviceTable tbody');if(!tbody)return;
            var h='';for(var k in data){var s=data[k];
            h+='<tr><td>'+k+'</td><td>'+(s.available?'<span class="badge bg-success">在线</span>':'<span class="badge bg-danger">离线</span>')+'</td><td>'+(s.message||'-')+'</td></tr>';}
            tbody.innerHTML=h;
        });
})();
</script>
}
