@model MallIndexVm
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "商城管理";
    // 改动说明（v2.3.0 商城虚拟权益 / v2.4.0 商家经济）：商城管理页三区——
    //   平台权益目录（价格/闪购/库存实时生效）、商家挂礼待审（审核定档=平台定价权）、
    //   托管中礼品单（争议退款队列）。
    // 时区规则：闪购窗口以 UTC 存储，展示与录入的本地化转换全部交给浏览器 JS
    //   （data-utc 输出 ISO 串 → datetime-local 本地值；提交前本地 → UTC 隐藏域），服务端不做时区转换
    string CategoryName(int c) => c switch { 1 => "置顶卡", 2 => "寻货次数包（预留）", 3 => "实物礼品", _ => "未知" };
    string Iso(DateTime? dt) => dt.HasValue ? dt.Value.ToString("yyyy-MM-ddTHH:mm:ssZ") : "";
    var items = Model.Items;
    var canVerify = PanelPerms.Has(User, "merchant.verify");
    var canManage = PanelPerms.Has(User, "merchant.manage");
    var canEdit = PanelPerms.Has(User, "system.manage");
    var mediaBase = (Configuration["Media:PublicBaseUrl"] ?? "https://bff.515813.xyz/media").TrimEnd('/');
}

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#pane-items" type="button">平台权益（@items.Count）</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pane-gifts" type="button">挂礼待审（@Model.Gifts.Count）</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pane-orders" type="button">托管订单（@Model.Orders.Count）</button>
    </li>
</ul>
<div class="tab-content">
    <div class="tab-pane fade show active" id="pane-items" role="tabpanel">
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>平台权益目录（@items.Count 个）</span>
        <span class="text-muted small">价格由平台统一定价；改价与闪购窗口保存后即时生效</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>商品键</th>
                        <th>名称</th>
                        <th class="d-none d-md-table-cell">类别</th>
                        <th class="d-none d-lg-table-cell">置顶对象</th>
                        <th>常规价</th>
                        <th class="d-none d-md-table-cell">闪购价</th>
                        <th class="d-none d-md-table-cell">闪购窗口（本地时间）</th>
                        <th class="d-none d-md-table-cell">时长</th>
                        <th>库存</th>
                        <th class="d-none d-md-table-cell">已售</th>
                        <th>状态</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in items.OrderBy(x => x.SortOrder).ThenBy(x => x.Key))
                    {
                        <tr>
                            <td><code class="small">@m.Key</code></td>
                            <td>@m.Name</td>
                            <td class="d-none d-md-table-cell">@CategoryName(m.Category)</td>
                            @* 改动说明（v2.10.0 寻货置顶）：置顶卡展示对象类型（商品/需求），非置顶卡显示 - *@
                            <td class="d-none d-lg-table-cell">@(m.Category == 1 ? (m.TargetKind == 2 ? "寻货需求" : "商品") : "-")</td>
                            <td>@m.PointPrice</td>
                            <td class="d-none d-md-table-cell">@(m.FlashPrice?.ToString() ?? "-")</td>
                            <td class="d-none d-md-table-cell small">
                                @if (m.FlashStart.HasValue && m.FlashEnd.HasValue)
                                {
                                    <span data-utc="@Iso(m.FlashStart)">-</span>
                                    <span> ~ </span>
                                    <span data-utc="@Iso(m.FlashEnd)">-</span>
                                }
                                else
                                {
                                    <span class="text-muted">无</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">@(m.DurationHours.HasValue ? m.DurationHours + " 小时" : "-")</td>
                            <td>@(m.Stock < 0 ? "不限" : m.Stock.ToString())</td>
                            <td class="d-none d-md-table-cell">@m.SoldCount</td>
                            <td>
                                @if (m.Enabled) { <span class="badge bg-success">上架</span> }
                                else { <span class="badge bg-secondary">停用</span> }
                            </td>
                            <td>
                                @if (canEdit)
                                {
                                    <button class="btn btn-sm btn-outline-primary btn-edit-item"
                                            title="编辑"
                                            data-id="@m.Id" data-name="@m.Name" data-desc="@m.Description"
                                            data-icon="@m.Icon" data-price="@m.PointPrice"
                                            data-flashprice="@(m.FlashPrice?.ToString() ?? "")"
                                            data-flashstart="@Iso(m.FlashStart)" data-flashend="@Iso(m.FlashEnd)"
                                            data-hours="@(m.DurationHours?.ToString() ?? "")"
                                            data-stock="@m.Stock" data-sort="@m.SortOrder"
                                            data-targetkind="@m.TargetKind"
                                            data-enabled="@m.Enabled.ToString().ToLower()">
                                        <i class="fas fa-pen"></i><span class="d-none d-sm-inline"> 编辑</span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

    </div>
    <div class="tab-pane" id="pane-gifts" role="tabpanel">
        @if (!canVerify)
        {
            <div class="alert alert-secondary">需要"商家审核"权限（merchant.verify）才能处理挂礼审核</div>
        }
        <div class="card">
            <div class="card-header">商家挂礼待审（@Model.Gifts.Count 件）<span class="text-muted small ms-2">通过后由平台定积分价（封顶价防定向转移），商家不可自定价</span></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead><tr><th>礼品</th><th class="d-none d-md-table-cell">描述</th><th>归属商家</th><th>数量</th><th class="d-none d-md-table-cell">提交时间</th><th>操作</th></tr></thead>
                        <tbody>
                            @foreach (var g in Model.Gifts)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(g.ImageKey))
                                            {
                                                <a href="@mediaBase@g.ImageKey" target="_blank" rel="noopener"><img src="@mediaBase@g.ImageKey" style="width:40px;height:40px;object-fit:contain;background:#fff;border-radius:6px" alt=""></a>
                                            }
                                            <span>@g.Name</span>
                                        </div>
                                    </td>
                                    <td class="d-none d-md-table-cell small text-muted">@g.Description</td>
                                    <td>@g.OwnerMerchantName</td>
                                    <td>@g.Stock</td>
                                    <td class="d-none d-md-table-cell"><span data-utc="@g.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")">-</span></td>
                                    <td>
                                        @if (canVerify)
                                        {
                                            <div class="d-flex align-items-center gap-1 flex-wrap">
                                                <form method="post" asp-action="ApproveGift" class="d-flex align-items-center gap-1">
                                                    <input type="hidden" name="id" value="@g.Id" />
                                                    <input type="number" name="pointPrice" class="form-control form-control-sm" style="width:90px" min="1" max="3000" placeholder="定档价" required />
                                                    <button type="submit" class="btn btn-sm btn-success">通过定档</button>
                                                </form>
                                                <form method="post" asp-action="RejectGift" class="d-inline">
                                                    <input type="hidden" name="id" value="@g.Id" />
                                                    <input type="hidden" name="reason" value="" class="reject-reason" />
                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-reject-gift" data-name="@g.Name">驳回</button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (Model.Gifts.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center text-muted py-3">暂无待审挂礼</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="tab-pane" id="pane-orders" role="tabpanel">
        <div class="card">
            <div class="card-header">托管中礼品单（@Model.Orders.Count 单）<span class="text-muted small ms-2">买家已托管扣分、尚未确认收货；争议时原路退分（已结算单不可退，需金库侧人工处理）</span></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead><tr><th>礼品</th><th>托管积分</th><th>物流态</th><th>收货人</th><th class="d-none d-md-table-cell">兑换时间</th><th>操作</th></tr></thead>
                        <tbody>
                            @foreach (var o in Model.Orders)
                            {
                                <tr>
                                    <td>@o.ItemName</td>
                                    <td>@o.PointsSpent</td>
                                    <td>@(o.ShipStatus == 1 ? Html.Raw("<span class='badge bg-warning text-dark'>待发货</span>") : Html.Raw("<span class='badge bg-info'>已发货</span>"))</td>
                                    <td class="small">@o.ReceiverName @o.ReceiverPhone</td>
                                    <td class="d-none d-md-table-cell"><span data-utc="@o.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")">-</span></td>
                                    <td>
                                        @if (canManage)
                                        {
                                            <form method="post" asp-action="RefundOrder" class="d-inline">
                                                <input type="hidden" name="id" value="@o.Id" />
                                                <input type="hidden" name="reason" value="" class="refund-reason" />
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-refund-order" data-name="@o.ItemName">争议退款</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (Model.Orders.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center text-muted py-3">没有托管中的礼品订单</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 编辑商品模态框 -->
<div class="modal fade" id="editItemModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-action="Update" id="itemForm">
                <input type="hidden" name="id" id="itId" />
                <input type="hidden" name="flashStartUtc" id="itStartUtc" />
                <input type="hidden" name="flashEndUtc" id="itEndUtc" />
                <div class="modal-header">
                    <h6 class="modal-title">编辑商品</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="form-label">名称</label>
                            <input type="text" name="name" id="itName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label">图标键</label>
                            <input type="text" name="icon" id="itIcon" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">描述（用户可见权益说明）</label>
                        <input type="text" name="description" id="itDesc" class="form-control" />
                    </div>
                    <div class="row">
                        <div class="col-md-3 mb-2">
                            <label class="form-label">常规价（积分；商品置顶卡=商家金）</label>
                            <input type="number" name="pointPrice" id="itPrice" class="form-control" min="0" required />
                        </div>
                        <div class="col-md-3 mb-2">
                            <label class="form-label">闪购价（留空=无闪购）</label>
                            <input type="number" name="flashPrice" id="itFlashPrice" class="form-control" min="0" />
                        </div>
                        <div class="col-md-3 mb-2">
                            <label class="form-label">时长（小时）</label>
                            <input type="number" name="durationHours" id="itHours" class="form-control" min="1" />
                        </div>
                        <div class="col-md-3 mb-2">
                            <label class="form-label">库存（-1=不限）</label>
                            <input type="number" name="stock" id="itStock" class="form-control" min="-1" />
                        </div>
                    </div>
                    @* 改动说明（v2.10.0 寻货置顶）：置顶卡的对象类型可纠正（商品=商家金定价/需求=积分定价） *@
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="form-label">置顶对象（仅置顶卡生效）</label>
                            <select name="targetKind" id="itTargetKind" class="form-select">
                                <option value="1">商品（商家金定价）</option>
                                <option value="2">寻货需求（积分定价）</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-5 mb-2">
                            <label class="form-label">闪购开始（本地时间）</label>
                            <input type="datetime-local" id="itStartLocal" class="form-control" />
                        </div>
                        <div class="col-md-5 mb-2">
                            <label class="form-label">闪购结束（本地时间）</label>
                            <input type="datetime-local" id="itEndLocal" class="form-control" />
                        </div>
                        <div class="col-md-2 mb-2">
                            <label class="form-label">排序</label>
                            <input type="number" name="sortOrder" id="itSort" class="form-control" min="0" />
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="enabled" value="true" id="itEnabled" />
                        <label class="form-check-label" for="itEnabled">上架（停用后商城不展示，历史订单不受影响）</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 闪购窗口的本地化转换全部在浏览器完成（服务端只存 UTC）
    function utcToLocalInput(iso) {
        if (!iso) return '';
        var d = new Date(iso);
        if (isNaN(d.getTime())) return '';
        var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
            'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }
    function localInputToUtc(v) {
        if (!v) return '';
        var d = new Date(v);
        if (isNaN(d.getTime())) return '';
        return d.toISOString();
    }

    document.querySelectorAll('.btn-edit-item').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('itId').value = btn.dataset.id;
            document.getElementById('itName').value = btn.dataset.name || '';
            document.getElementById('itDesc').value = btn.dataset.desc || '';
            document.getElementById('itIcon').value = btn.dataset.icon || '';
            document.getElementById('itPrice').value = btn.dataset.price || '0';
            document.getElementById('itFlashPrice').value = btn.dataset.flashprice || '';
            document.getElementById('itHours').value = btn.dataset.hours || '';
            document.getElementById('itStock').value = btn.dataset.stock || '-1';
            document.getElementById('itSort').value = btn.dataset.sort || '0';
            // 改动说明（v2.10.0 寻货置顶）：回填置顶对象类型
            document.getElementById('itTargetKind').value = btn.dataset.targetkind || '1';
            document.getElementById('itEnabled').checked = btn.dataset.enabled === 'true';
            document.getElementById('itStartLocal').value = utcToLocalInput(btn.dataset.flashstart);
            document.getElementById('itEndLocal').value = utcToLocalInput(btn.dataset.flashend);
            new bootstrap.Modal(document.getElementById('editItemModal')).show();
        });
    });

    // 提交前把本地时间转回 UTC 隐藏域
    document.getElementById('itemForm').addEventListener('submit', function () {
        document.getElementById('itStartUtc').value = localInputToUtc(document.getElementById('itStartLocal').value);
        document.getElementById('itEndUtc').value = localInputToUtc(document.getElementById('itEndLocal').value);
    });

    // v2.4.0 挂礼驳回：showPrompt 填原因后提交（原因商户可见）
    document.querySelectorAll('.btn-reject-gift').forEach(function (btn) {
        btn.addEventListener('click', function () {
            showPrompt({ title: '驳回「' + btn.dataset.name + '」', message: '填写驳回原因（商家可见，可修改后重新申请）', placeholder: '例如：图片不清晰 / 描述含联系方式 / 库存证明不足' }).then(function (reason) {
                if (reason === null) return;
                var form = btn.closest('form');
                form.querySelector('.reject-reason').value = reason || '不符合平台挂礼要求';
                form.submit();
            });
        });
    });

    // v2.4.0 托管订单争议退款：二次确认 + 原因
    document.querySelectorAll('.btn-refund-order').forEach(function (btn) {
        btn.addEventListener('click', function () {
            showPrompt({ title: '争议退款「' + btn.dataset.name + '」', message: '填写退款原因（买家可见），确认后积分原路退回', placeholder: '例如：商家缺货协商退款 / 未按时发货' }).then(function (reason) {
                if (reason === null) return;
                var form = btn.closest('form');
                form.querySelector('.refund-reason').value = reason || '平台争议处理退款';
                form.submit();
            });
        });
    });
</script>
}
