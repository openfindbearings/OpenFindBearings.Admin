@{
    ViewData["Title"] = "入驻申请审批";
    var items = ViewBag.Items as IEnumerable<MerchantItemDto> ?? [];
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var currentStatus = (string?)ViewBag.Status;
    var totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    var search = (string?)ViewBag.Search ?? "";
    var error = (string?)ViewBag.Error;
}

<div class="page-header">
    <h4><i class="fas fa-user-check"></i> 入驻申请审批</h4>
    <p class="text-muted">商家入驻申请审批，认证通过后商家可正常经营</p>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "pending" ? "active" : "")" href="@Url.Action("Index", new { status = "pending", search, page = 1 })">待认证</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "suspended" ? "active" : "")" href="@Url.Action("Index", new { status = "suspended", search, page = 1 })">已拒绝</a>
    </li>
</ul>

<div class="card">
    <div class="card-header d-flex justify-content-end align-items-center py-2">
        <form class="d-flex gap-2" method="get">
            <input type="hidden" name="status" value="@currentStatus" />
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="搜索商家名称..." />
            <button class="btn btn-sm btn-primary"><i class="bi bi-search"></i></button>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>名称</th>
                        <th>公司全称</th>
                        <th>类型</th>
                        <th>联系人</th>
                        <th>手机</th>
                        <th>状态</th>
                        <th style="width:240px">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (items.Any())
                    {
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@(item.CompanyName ?? "-")</td>
                                <td>@item.Type</td>
                                <td>@(item.ContactPerson ?? "-")</td>
                                <td>@(item.Mobile ?? item.Phone ?? "-")</td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">已认证</span>
                                    }
                                    else if (item.Status == "Suspended")
                                    {
                                        <span class="badge bg-secondary">已拒绝</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">待认证</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status != "Active")
                                    {
                                        <button class="btn btn-sm btn-success btn-verify" data-id="@item.Id"><i class="fas fa-check"></i> 认证</button>
                                        <button class="btn btn-sm btn-outline-danger btn-reject" data-id="@item.Id"><i class="fas fa-times"></i> 拒绝</button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">已认证</span>
                                    }
                                    <button class="btn btn-sm btn-outline-info btn-sync-data" data-id="@item.Id" data-name="@item.Name">同步数据</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted"><i class="fas fa-check-circle fa-2x mb-2"></i><br />暂无商家数据</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">共 @totalPages 页 / @totalCount 条</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = 1 })">首页</a>
                        </li>
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = page - 1 })">&laquo;</a>
                        </li>
                        @{
                            var rs = Math.Max(1, page - 2);
                            var re = Math.Min(totalPages, page + 2);
                        }
                        @if (rs > 1) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                        @for (var p = rs; p <= re; p++)
                        {
                            <li class="page-item @(p == page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = p })">@p</a>
                            </li>
                        }
                        @if (re < totalPages) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = page + 1 })">&raquo;</a>
                        </li>
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = totalPages })">尾页</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

@* --- 同步数据弹出框 --- *@
<div class="modal fade" id="syncDataModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">历史同步数据 - <span id="syncDataMerchantName"></span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom small text-muted">
                    <span>共 <span id="syncDataTotalCount">0</span> 条</span>
                    <label class="d-flex align-items-center gap-1">
                        <input type="checkbox" id="syncDataShowAll" />
                        显示全部（含非在售）
                    </label>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>型号</th>
                                <th>曾用代号</th>
                                <th>类型</th>
                                <th>尺寸</th>
                                <th>品牌</th>
                                <th>来源</th>
                                <th>状态</th>
                            </tr>
                        </thead>
                        <tbody id="syncDataBody">
                            <tr><td colspan="7" class="text-center text-muted py-4">加载中...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">关闭</button>
            </div>
        </div>
    </div>
</div>

@* --- 拒绝弹出框 --- *@
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">拒绝认证</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">拒绝原因</label>
                    <textarea class="form-control" id="rejectReason" rows="3" placeholder="请填写拒绝原因"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-sm btn-danger" id="rejectConfirmBtn">确认拒绝</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let rejectMerchantId = null;

        $('.btn-verify').on('click', function () {
            const id = $(this).data('id');
            if (!confirm('确认认证该商家？')) return;
            $.post('@Url.Action("Verify")', { id })
                .done(function (res) {
                    if (res.success) {
                        showToast('success', res.message || '已认证');
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showToast('danger', res.message || '操作失败');
                    }
                })
                .fail(function () {
                    showToast('danger', '服务异常');
                });
        });

        $('.btn-reject').on('click', function () {
            rejectMerchantId = $(this).data('id');
            $('#rejectReason').val('');
            $('#rejectModal').modal('show');
        });

        $('#rejectConfirmBtn').on('click', function () {
            if (!rejectMerchantId) return;
            const reason = $('#rejectReason').val().trim();
            if (!reason) {
                showToast('warning', '请填写拒绝原因');
                return;
            }
            $.post('@Url.Action("Reject")', { id: rejectMerchantId, reason })
                .done(function (res) {
                    $('#rejectModal').modal('hide');
                    if (res.success) {
                        showToast('success', res.message || '已拒绝');
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showToast('danger', res.message || '操作失败');
                    }
                })
                .fail(function () {
                    $('#rejectModal').modal('hide');
                    showToast('danger', '服务异常');
                });
        });

        function loadSyncData(id) {
            const showAll = document.getElementById('syncDataShowAll').checked;
            var url = '@Url.Action("GetMerchantBearings", new { id = "PLACEHOLDER" })'.replace('PLACEHOLDER', id) + '?dataSource=Crawler&pageSize=9999';
            if (!showAll) url += '&onlyOnSale=true';
            fetch(url)
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    var totalCount = d && d.data ? d.data.totalCount : 0;
                    var items = d && d.data ? d.data.items || [] : d.items || d || [];
                    if (!Array.isArray(items)) items = [];
                    $('#syncDataTotalCount').text(totalCount);
                    if (items.length === 0) {
                        $('#syncDataBody').html('<tr><td colspan="7" class="text-center text-muted py-4">无同步数据</td></tr>');
                        return;
                    }
                    var h = '';
                    items.forEach(function (r) {
                        var statusText = r.isOnSale ? '在售' : '下架';
                        h += '<tr><td>' + (r.bearingPartNumber || '-') + '</td><td>' + (r.bearingOldNumber || '-') + '</td><td>' + (r.bearingTypeName || r.bearingType || '-') + '</td><td>' + (r.dimensions || '-') + '</td><td>' + (r.brandName || r.brand || '-') + '</td><td>爬虫</td><td>' + statusText + '</td></tr>';
                    });
                    $('#syncDataBody').html(h);
                })
                .catch(function () {
                    $('#syncDataBody').html('<tr><td colspan="7" class="text-center text-danger py-4">加载失败</td></tr>');
                });
        }

        var syncDataMerchantId = null;

        $('.btn-sync-data').on('click', function () {
            syncDataMerchantId = $(this).data('id');
            const name = $(this).data('name');
            $('#syncDataMerchantName').text(name);
            $('#syncDataTotalCount').text('0');
            document.getElementById('syncDataShowAll').checked = false;
            $('#syncDataBody').html('<tr><td colspan="5" class="text-center text-muted py-4">加载中...</td></tr>');
            $('#syncDataModal').modal('show');
            loadSyncData(syncDataMerchantId);
        });

        document.getElementById('syncDataShowAll').addEventListener('change', function () {
            if (syncDataMerchantId) loadSyncData(syncDataMerchantId);
        });
    </script>
}