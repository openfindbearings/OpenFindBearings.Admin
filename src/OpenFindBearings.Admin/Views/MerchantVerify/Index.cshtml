@inject IConfiguration Config
@{
    ViewData["Title"] = "入驻申请审批";
    var items = ViewBag.Items as IEnumerable<MerchantItemDto> ?? [];
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var currentStatus = (string?)ViewBag.Status;
    var totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    var search = (string?)ViewBag.Search ?? "";
    var error = (string?)ViewBag.Error;

    // 改动说明：商家类型枚举名转中文（v1.21.1，运营要求列表/抽屉不再露英文枚举）
    string MerchantTypeName(string t) => t switch
    {
        "Manufacturer" => "生产厂家",
        "AuthorizedDealer" => "授权经销商",
        "Distributor" => "分销商",
        "Trader" => "贸易商",
        _ => t
    };

    // 改动说明：入驻渠道码转中文（对齐 API ApplicationMode 枚举）
    static string ModeLabel(string? mode) => mode switch
    {
        "Self" => "自助新建",
        "Claim" => "认领",
        "Nomination" => "提名",
        "None" or null or "" => "-",
        _ => mode
    };
}

<div class="page-header">
    <h4><i class="fas fa-user-check"></i> 入驻申请审批</h4>
    <p class="text-muted">入驻审核通过使商户生效可被检索；认证（提交营业执照）用于提升商户资质等级，二者相互独立。点击行可打开详情抽屉核对全部申请资料</p>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "pending" ? "active" : "")" href="@Url.Action("Index", new { status = "pending", search, page = 1 })">待审核</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "active" ? "active" : "")" href="@Url.Action("Index", new { status = "active", search, page = 1 })">已生效</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "suspended" ? "active" : "")" href="@Url.Action("Index", new { status = "suspended", search, page = 1 })">已拒绝</a>
    </li>
</ul>

<div class="card">
    <div class="card-header d-flex justify-content-end align-items-center py-2">
        <form class="d-flex gap-2" method="get">
            <input type="hidden" name="status" value="@currentStatus" />
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="搜索商家名称..." />
            <button class="btn btn-sm btn-primary"><i class="bi bi-search"></i></button>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>名称</th>
                        <th>公司全称</th>
                        <th>类型</th>
                        <th>渠道</th>
                        <th>联系人</th>
                        <th>手机</th>
                        <th>提交时间</th>
                        <th>状态</th>
                        <th style="width:240px">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (items.Any())
                    {
                        @foreach (var item in items)
                        {
                            <tr class="merchant-row" data-id="@item.Id" data-name="@item.Name" style="cursor:pointer">
                                <td>@item.Name</td>
                                <td>
                                    @(item.CompanyName ?? "-")
                                    @* 改动说明：待审核且企业名称为空时标黄提示（审核依据不足，建议驳回补全） *@
                                    @if (item.Status == "Pending" && string.IsNullOrWhiteSpace(item.CompanyName))
                                    {
                                        <i class="fas fa-exclamation-triangle text-warning ms-1" title="缺营业执照企业名称，建议驳回补全"></i>
                                    }
                                </td>
                                <td>@MerchantTypeName(item.Type)</td>
                                <td>@ModeLabel(item.ApplicationMode)</td>
                                <td>@(item.ContactPerson ?? "-")</td>
                                <td>@(item.Mobile ?? item.Phone ?? "-")</td>
                                <td>@(item.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">已生效</span>
                                        @if (item.IsVerified)
                                        {
                                            <span class="badge bg-primary ms-1">已认证</span>
                                        }
                                        else if (item.VerifyRequested)
                                        {
                                            @* v1.22.0：商户已主动申请认证的优先处理信号 *@
                                            <span class="badge bg-warning text-dark ms-1">申请认证</span>
                                        }
                                    }
                                    else if (item.Status == "Suspended")
                                    {
                                        <span class="badge bg-secondary">已拒绝</span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">待审核</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <button class="btn btn-sm btn-success btn-approve" data-id="@item.Id"><i class="fas fa-check-double"></i> 审核通过</button>
                                        <button class="btn btn-sm btn-outline-danger btn-reject" data-id="@item.Id"><i class="fas fa-times"></i> 拒绝</button>
                                    }
                                    else if (item.Status == "Active" && !item.IsVerified)
                                    {
                                        <button class="btn btn-sm btn-outline-success btn-verify" data-id="@item.Id"><i class="fas fa-check"></i> 认证</button>
                                    }
                                    <button class="btn btn-sm btn-outline-primary btn-detail" data-id="@item.Id"><i class="fas fa-id-card"></i> 详情</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9" class="text-center py-5 text-muted"><i class="fas fa-check-circle fa-2x mb-2"></i><br />暂无商家数据</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">共 @totalPages 页 / @totalCount 条</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = 1 })">首页</a>
                        </li>
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = page - 1 })">&laquo;</a>
                        </li>
                        @{
                            var rs = Math.Max(1, page - 2);
                            var re = Math.Min(totalPages, page + 2);
                        }
                        @if (rs > 1) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                        @for (var p = rs; p <= re; p++)
                        {
                            <li class="page-item @(p == page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = p })">@p</a>
                            </li>
                        }
                        @if (re < totalPages) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = page + 1 })">&raquo;</a>
                        </li>
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = totalPages })">尾页</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

@* --- 详情抽屉：申请资料全量 + 爬虫历史数据比对（替代原独立"同步数据"弹窗，主流审批"先看全资料再决策"） --- *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="detailDrawer" style="width:620px">
    <div class="offcanvas-header">
        <h6 class="offcanvas-title">申请详情 - <span id="drawerName"></span></h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div id="drawerLoading" class="text-center text-muted py-5">加载中...</div>
        <div id="drawerContent" class="d-none">
            <h6 class="text-muted small mb-2">申请资料</h6>
            <table class="table table-sm">
                <tbody>
                    <tr><th style="width:130px">商家名称</th><td id="dName">-</td></tr>
                    <tr><th>企业名称</th><td id="dCompanyName">-</td></tr>
                    <tr><th>统一社会信用代码</th><td id="dCreditCode">-</td></tr>
                    <tr><th>商家类型</th><td id="dType">-</td></tr>
                    <tr><th>入驻渠道</th><td id="dMode">-</td></tr>
                    <tr><th>提交时间</th><td id="dSubmittedAt">-</td></tr>
                    <tr><th>联系人</th><td id="dContact">-</td></tr>
                    <tr><th>联系电话</th><td id="dPhone">-</td></tr>
                    <tr><th>地址</th><td id="dAddress">-</td></tr>
                    <tr><th>简介</th><td id="dDesc">-</td></tr>
                    <tr><th>状态</th><td id="dStatus">-</td></tr>
                    <tr><th>拒绝原因</th><td id="dReject">-</td></tr>
                    <tr><th>Logo</th><td id="dLogo">-</td></tr>
                </tbody>
            </table>
            <div id="drawerWarn" class="alert alert-warning py-2 small d-none">
                缺营业执照企业名称：审核依据不足，建议驳回并要求补全后重新提交。
            </div>

            @* v2.7.0 新增：随单证照材料区——审核人看材料再决策；审批通过后由 API 级联置为已通过 *@
            <h6 class="text-muted small mt-4 mb-2">申请证照材料</h6>
            <div id="dDocs" class="row g-2"></div>
            <div id="dDocsEmpty" class="text-muted small d-none">该申请未随附材料（历史通道数据），可要求驳回补全。</div>

            <h6 class="text-muted small mt-4 mb-2">爬虫历史数据比对</h6>
            <div class="d-flex justify-content-between align-items-center mb-1 small text-muted">
                <span>共 <span id="drawerSyncTotal">0</span> 条</span>
                <label class="d-flex align-items-center gap-1">
                    <input type="checkbox" id="drawerShowAll" />
                    显示全部（含非在售）
                </label>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>型号</th>
                            <th>曾用代号</th>
                            <th>类型</th>
                            <th>尺寸</th>
                            <th>品牌</th>
                            <th>状态</th>
                        </tr>
                    </thead>
                    <tbody id="drawerSyncBody">
                        <tr><td colspan="6" class="text-center text-muted py-3">加载中...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @* v1.22.0 抽屉底栏操作区：看完成员就地决策（原按钮只在行内，抽屉 620px 盖住行按钮导致"一步一卡"）；
       按钮显隐由 openDrawer 按商户状态渲染 *@
    <div class="offcanvas-footer border-top p-3 d-none" id="drawerActions">
        <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-sm btn-outline-danger" id="drawerReject"><i class="fas fa-times"></i> 拒绝</button>
            <button type="button" class="btn btn-sm btn-outline-success" id="drawerVerify"><i class="fas fa-check"></i> 认证</button>
            <button type="button" class="btn btn-sm btn-success" id="drawerApprove"><i class="fas fa-check-double"></i> 审核通过</button>
        </div>
    </div>
</div>

@* --- 拒绝弹出框：预设原因分类 + 补充说明（改动说明：原自由文本升级为结构化，随状态回传申请人） --- *@
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">拒绝入驻申请</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">拒绝原因分类 <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" id="rejectCategory">
                        <option value="">请选择...</option>
                        <option value="资料不完整">资料不完整</option>
                        <option value="营业执照信息不符">营业执照信息不符</option>
                        <option value="疑似重复入驻">疑似重复入驻</option>
                        <option value="涉嫌违规经营">涉嫌违规经营</option>
                        <option value="其他">其他</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">补充说明 <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="rejectReason" rows="3" placeholder="向申请人说明的具体情况（必填）"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-sm btn-danger" id="rejectConfirmBtn">确认拒绝</button>
            </div>
        </div>
    </div>
</div>

@* v1.21.1 材料 lightbox：自绘全屏遮罩。
   改动说明：不用 BS modal——它与 offcanvas 各有焦点陷阱，抽屉上叠加时互相抢焦点，
   data-bs-dismiss 失灵关不掉；自绘层纯显隐，点空白/✕/ESC 均可关，PDF 用 iframe 内嵌预览 *@
<div id="docViewer" style="display:none;position:fixed;inset:0;z-index:3000;background:rgba(0,0,0,.86);cursor:zoom-out">
    <img id="docViewerImg" alt="" style="display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-width:92vw;max-height:86vh;border-radius:6px;box-shadow:0 0 24px rgba(0,0,0,.5);cursor:default">
    <iframe id="docViewerFrame" title="材料预览" style="display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(900px,92vw);height:86vh;border:0;border-radius:6px;background:#fff"></iframe>
    <button type="button" id="docViewerClose" aria-label="关闭" style="position:absolute;top:16px;right:20px;width:40px;height:40px;border-radius:50%;border:0;background:rgba(255,255,255,.92);color:#212529;font-size:22px;line-height:1;cursor:pointer">&times;</button>
</div>

@section Scripts {
    <script>
        // 改动说明：项目为 Bootstrap 5.3，组件 API 一律用 bootstrap.Xxx.getOrCreateInstance
        //   （原 $('#m').modal('show') 是 BS4 jQuery 插件写法，在 BS5 下静默失效）
        let rejectMerchantId = null;

        // v1.21.1：材料/Logo 文件由媒体服务反代 MinIO 直出，拼【公网】媒体基址——
        //   原拼 API 集群内 svc 地址浏览器不可达，图片 onerror 隐藏后卡片呈现"不可点"
        const DOC_BASE = ('@(Config["Media:PublicBaseUrl"] ?? "https://bff.515813.xyz/media")').replace(/\/+$/, '');

        /** 渲染抽屉"申请证照材料"卡片区（v1.21.1 重构：缩略图主导 + 点击 lightbox 放大，PDF 显图标） */
        function renderDocs(docs) {
            const $box = $('#dDocs');
            $box.empty();
            if (!docs || !docs.length) {
                $('#dDocsEmpty').removeClass('d-none');
                return;
            }
            $('#dDocsEmpty').addClass('d-none');
            const docStatus = { Pending: ['待审核', 'bg-warning text-dark'], Approved: ['已通过', 'bg-success'], Rejected: ['已拒绝', 'bg-danger'] };
            docs.forEach(function (it) {
                const st = docStatus[it.status] || [it.status || '-', 'bg-secondary'];
                const url = DOC_BASE + (it.fileUrl || '');
                const isPdf = /\.pdf$/i.test(it.fileUrl || '');
                const preview = isPdf
                    ? '<div class="d-flex align-items-center justify-content-center" style="height:110px"><i class="fas fa-file-pdf fa-3x text-danger"></i></div>'
                    : '<img src="' + esc(url) + '" alt="" style="height:110px;width:100%;object-fit:cover;border-radius:4px" onerror="this.outerHTML=\'<div class=&quot;text-muted small d-flex align-items-center justify-content-center&quot; style=&quot;height:110px&quot;>图片加载失败</div>\'">';
                $box.append(
                    '<div class="col-6"><div class="border rounded p-2 h-100">' +
                    '<div class="d-flex justify-content-between mb-1">' +
                    '<span class="badge bg-info text-dark">' + esc(it.typeName || '材料') + '</span>' +
                    '<span class="badge ' + st[1] + '">' + esc(st[0]) + '</span></div>' +
                    '<a href="javascript:void(0)" class="doc-viewer-link" data-url="' + esc(url) + '">' + preview + '</a>' +
                    (it.reviewComment ? '<div class="small text-danger mt-1">' + esc(it.reviewComment) + '</div>' : '') +
                    '</div></div>');
            });
        }

        // 材料 lightbox 显隐（v1.21.1 自绘遮罩：BS modal 与 offcanvas 焦点陷阱冲突关不掉；
        //   点空白/✕ 关闭，ESC 关闭并阻断冒泡防抽屉连带的抢焦行为，PDF 走 iframe 内嵌）
        // 改动说明（v1.22.0 审查修复）：src 置空串部分浏览器会重新加载当前页，改 removeAttr
        function openDocViewer(url) {
            const isPdf = /\.pdf$/i.test(url);
            $('#docViewerImg').toggle(!isPdf);
            $('#docViewerFrame').toggle(isPdf);
            if (isPdf) { $('#docViewerImg').removeAttr('src'); $('#docViewerFrame').attr('src', url); }
            else { $('#docViewerFrame').removeAttr('src'); $('#docViewerImg').attr('src', url); }
            $('#docViewer').show();
        }
        function closeDocViewer() {
            $('#docViewer').hide();
            $('#docViewerImg').removeAttr('src');
            $('#docViewerFrame').removeAttr('src');
        }
        $(document).on('click', '.doc-viewer-link', function () { openDocViewer($(this).data('url')); });
        $('#docViewer').on('click', function (e) {
            if (e.target === this || e.target.id === 'docViewerClose') closeDocViewer();
        });
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' && $('#docViewer').is(':visible')) { e.stopImmediatePropagation(); closeDocViewer(); }
        });

        // 改动说明（v1.22.0）：showToast 已由 dialogs.js 全局提供，去掉 alert 兜底；danger 为 BS 别名
        function toast(type, msg) { showToast(type === 'danger' ? 'error' : type, msg); }

        // ============ 审批动作（v1.22.0 审查修复：抽公共函数供行按钮与抽屉底栏共用；
        //   原 btn-approve/btn-verify 漏 stopPropagation，点按钮连带整行点击误开抽屉） ============
        function afterActionSuccess(msg) {
            toast('success', msg);
            const oc = bootstrap.Offcanvas.getInstance(document.getElementById('detailDrawer'));
            if (oc) oc.hide(); // 操作完成后收起抽屉再刷新，避免停留在已处理的详情
            setTimeout(() => location.reload(), 800);
        }

        function approveMerchant(id) {
            showConfirm({ message: '确认审核通过该入驻申请？商户将生效并可在 C 端被检索。', okText: '审核通过' }).then(function (ok) {
                if (!ok) return;
                $.post('@Url.Action("Approve")', { id })
                    .done(function (res) {
                        if (res.success) {
                            afterActionSuccess(res.message || '已审核通过');
                        } else {
                            // 改动说明：并发冲突（另一管理员已处理）提示后自动刷新列表，其余失败仅提示
                            toast(res.conflict ? 'warning' : 'danger', res.message || '操作失败');
                            if (res.conflict) setTimeout(() => location.reload(), 1200);
                        }
                    })
                    .fail(function () { toast('danger', '服务异常'); });
            });
        }

        function verifyMerchant(id) {
            showConfirm({ message: '确认认证该商家？（认证提升资质等级，不影响生效状态）', okText: '认证' }).then(function (ok) {
                if (!ok) return;
                $.post('@Url.Action("Verify")', { id })
                    .done(function (res) {
                        if (res.success) {
                            afterActionSuccess(res.message || '已认证');
                        } else {
                            toast('danger', res.message || '操作失败');
                        }
                    })
                    .fail(function () { toast('danger', '服务异常'); });
            });
        }

        /** 打开拒绝弹窗；fromDrawer=true 时先关抽屉——rejectModal 是 BS modal，
            叠在 offcanvas 上会复现焦点陷阱冲突（关不掉），关闭下层再弹可规避 */
        function openRejectDialog(id, fromDrawer) {
            rejectMerchantId = id;
            $('#rejectCategory').val('');
            $('#rejectReason').val('');
            if (fromDrawer) {
                const oc = bootstrap.Offcanvas.getInstance(document.getElementById('detailDrawer'));
                if (oc) oc.hide();
                setTimeout(function () {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('rejectModal')).show();
                }, 320); // 等 offcanvas 滑出动画（150ms+缓冲）结束再弹，避免过渡期抢焦点
            } else {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('rejectModal')).show();
            }
        }

        $('.btn-approve').on('click', function (e) {
            e.stopPropagation();
            approveMerchant($(this).data('id'));
        });

        $('.btn-verify').on('click', function (e) {
            e.stopPropagation();
            verifyMerchant($(this).data('id'));
        });

        $('.btn-reject').on('click', function (e) {
            e.stopPropagation();
            openRejectDialog($(this).data('id'), false);
        });

        $('#rejectConfirmBtn').on('click', function () {
            if (!rejectMerchantId) return;
            const category = $('#rejectCategory').val();
            const note = $('#rejectReason').val().trim();
            if (!category) { toast('warning', '请选择拒绝原因分类'); return; }
            if (!note) { toast('warning', '请填写补充说明'); return; }
            // 改动说明：结构化提交"分类：说明"，Taro 端驳回原因与站内信正文直接展示该格式
            const reason = category + '：' + note;
            $.post('@Url.Action("Reject")', { id: rejectMerchantId, reason })
                .done(function (res) {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('rejectModal')).hide();
                    if (res.success) {
                        toast('success', res.message || '已拒绝');
                        setTimeout(() => location.reload(), 800);
                    } else {
                        toast(res.conflict ? 'warning' : 'danger', res.message || '操作失败');
                        if (res.conflict) setTimeout(() => location.reload(), 1200);
                    }
                })
                .fail(function () {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('rejectModal')).hide();
                    toast('danger', '服务异常');
                });
        });

        // ============ 详情抽屉 ============
        let drawerMerchantId = null;

        /** 抽屉内爬虫历史数据表（原独立"同步数据"弹窗并入抽屉，作为认领场景的资料比对） */
        function loadDrawerSyncData() {
            if (!drawerMerchantId) return;
            const showAll = document.getElementById('drawerShowAll').checked;
            let url = '@Url.Action("GetMerchantBearings", new { id = "PLACEHOLDER" })'.replace('PLACEHOLDER', drawerMerchantId) + '?dataSource=Crawler&pageSize=9999';
            if (!showAll) url += '&onlyOnSale=true';
            fetch(url)
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    const totalCount = d && d.data ? d.data.totalCount : 0;
                    let items = d && d.data ? d.data.items || [] : (d.items || []);
                    if (!Array.isArray(items)) items = [];
                    $('#drawerSyncTotal').text(totalCount);
                    if (items.length === 0) {
                        $('#drawerSyncBody').html('<tr><td colspan="6" class="text-center text-muted py-3">无爬虫历史数据（自助新建商户属正常）</td></tr>');
                        return;
                    }
                    let h = '';
                    items.forEach(function (r) {
                        const statusText = r.isOnSale ? '在售' : '下架';
                        h += '<tr><td>' + (r.bearingPartNumber || '-') + '</td><td>' + (r.bearingOldNumber || '-') + '</td><td>' + (r.bearingTypeName || '-') + '</td><td>' + (r.dimensions || '-') + '</td><td>' + (r.brandName || '-') + '</td><td>' + statusText + '</td></tr>';
                    });
                    $('#drawerSyncBody').html(h);
                })
                .catch(function () {
                    $('#drawerSyncBody').html('<tr><td colspan="6" class="text-center text-danger py-3">加载失败</td></tr>');
                });
        }

        function esc(s) { return $('<i>').text(s == null ? '' : String(s)).html(); }

        function openDrawer(id, name) {
            drawerMerchantId = id;
            $('#drawerName').text(name || '');
            // 改动说明（v1.22.0 审查修复）：上次加载失败后文案残留"加载失败"，重开时复位
            $('#drawerLoading').removeClass('d-none').text('加载中...');
            $('#drawerContent').addClass('d-none');
            $('#drawerActions').addClass('d-none');
            bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('detailDrawer')).show();
            fetch('@Url.Action("Detail", new { id = "PLACEHOLDER" })'.replace('PLACEHOLDER', id))
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    const d = res && res.data ? res.data : null;
                    if (!d) { $('#drawerLoading').text('加载失败'); return; }
                    $('#drawerLoading').addClass('d-none');
                    $('#drawerContent').removeClass('d-none');
                    const modeMap = { self: '自助新建', claim: '认领', nomination: '提名', none: '-' };
                    const statusMap = { Pending: '待审核', Active: '已生效', Suspended: '已拒绝', Draft: '草稿' };
                    // 改动说明（v1.21.1）：status/mode 大小写归一再查表（API 侧 mode 输出小写、status 输出 PascalCase，
                    //   原表只匹配一种导致抽屉"状态 -"）
                    const normKey = function (s) { return s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : ''; };
                    $('#dName').text(d.name || '-');
                    $('#dCompanyName').text(d.companyName || '-');
                    $('#dCreditCode').text(d.unifiedSocialCreditCode || '-');
                    const typeMap = { Manufacturer: '生产厂家', AuthorizedDealer: '授权经销商', Distributor: '分销商', Trader: '贸易商' };
                    $('#dType').text(typeMap[d.type] || d.type || '-');
                    $('#dMode').text(modeMap[normKey(d.applicationMode)] || d.applicationMode || '-');
                    $('#dSubmittedAt').text(d.submittedAt ? new Date(d.submittedAt).toLocaleString('zh-CN') : '-');
                    $('#dContact').text(d.contactPerson || '-');
                    $('#dPhone').text(d.mobile || d.phone || '-');
                    $('#dAddress').text(d.address || '-');
                    $('#dDesc').text(d.description || '-');
                    $('#dStatus').text((statusMap[normKey(d.status)] || d.status || '-') + (d.isVerified ? ' · 已认证' : (d.verifyRequested ? ' · 已申请认证' : '')));
                    $('#dReject').text(d.rejectReason || '-');
                    // 改动说明（v1.21.1）：Logo 同样走公网媒体基址（相对键直拼在 Admin 域下 404）
                    $('#dLogo').html(d.logoUrl ? '<img src="' + esc(DOC_BASE + d.logoUrl) + '" style="max-height:60px;max-width:160px">' : '-');
                    document.getElementById('drawerWarn').classList.toggle('d-none', !!d.companyName);
                    // v1.22.0 抽屉底栏：按状态就地决策（Pending 审核通过/拒绝；Active 未认证显认证）
                    $('#drawerApprove').toggleClass('d-none', d.status !== 'Pending');
                    $('#drawerReject').toggleClass('d-none', d.status !== 'Pending');
                    $('#drawerVerify').toggleClass('d-none', !(d.status === 'Active' && !d.isVerified));
                    $('#drawerActions').removeClass('d-none');
                    renderDocs(d.documents); // v2.7.0 抽屉材料区（Detail 已服务端合并）
                    loadDrawerSyncData();
                })
                .catch(function () { $('#drawerLoading').text('加载失败'); });
        }

        // 抽屉底栏三键（静态 HTML，直接绑定；id 用当前抽屉商户）
        $('#drawerApprove').on('click', function () { approveMerchant(drawerMerchantId); });
        $('#drawerVerify').on('click', function () { verifyMerchant(drawerMerchantId); });
        $('#drawerReject').on('click', function () { openRejectDialog(drawerMerchantId, true); });

        $('.btn-detail').on('click', function (e) {
            e.stopPropagation();
            const $tr = $(this).closest('tr');
            openDrawer($tr.data('id'), $tr.data('name'));
        });

        // 改动说明：整行点击也开抽屉（主流后台列表惯例），操作按钮已 stopPropagation 不冲突
        $('.merchant-row').on('click', function () {
            openDrawer($(this).data('id'), $(this).data('name'));
        });

        document.getElementById('drawerShowAll').addEventListener('change', loadDrawerSyncData);
    </script>
}
