@model PendingReviewListViewModel
@{
    ViewData["Title"] = "同步数据审核";
    string PageUrl(int p) => $"?type={Model.CurrentFilter}&page={p}";
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<div class="page-header">
    <h4><i class="fas fa-check-double"></i> 同步数据审核</h4>
    <p class="text-muted">Sync ETL 数据同步前的待审核项，可编辑补全字段后通过，下次 T/L 阶段同步至业务库</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<ul class="nav nav-tabs mb-3" id="reviewTabs">
    <li class="nav-item">
        <a class="nav-link @(string.IsNullOrEmpty(Model.CurrentFilter) ? "active" : "")"
           asp-action="Index" asp-route-type="">全部</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.CurrentFilter == "brand" ? "active" : "")"
           asp-action="Index" asp-route-type="brand">品牌</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.CurrentFilter == "bearing_type" ? "active" : "")"
           asp-action="Index" asp-route-type="bearing_type">类型</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.CurrentFilter == "bearing" ? "active" : "")"
           asp-action="Index" asp-route-type="bearing">轴承</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.CurrentFilter == "merchant" ? "active" : "")"
           asp-action="Index" asp-route-type="merchant">商家</a>
    </li>
</ul>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Items.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-check-circle fa-3x mb-3"></i>
                <p>暂无待审核数据</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width:80px">类型</th>
                            <th>原始值</th>
                            <th>建议值</th>
                            <th style="width:80px">置信度</th>
                            <th style="width:140px">创建时间</th>
                            <th style="width:170px">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr data-review-id="@item.Id">
                                <td><span class="badge bg-info">@item.EntityTypeDisplay</span></td>
                                <td>@item.OriginalValue</td>
                                <td>@(item.SuggestedValue ?? "-")</td>
                                <td>
                                    @if (item.ConfidenceDisplay.HasValue)
                                    {
                                        var cls = item.ConfidenceDisplay.Value >= 70 ? "success" :
                                                 item.ConfidenceDisplay.Value >= 40 ? "warning" : "danger";
                                        <span class="badge bg-@cls">@item.ConfidenceDisplay%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-muted small" data-utc="@item.CreatedAtUtc">@item.CreatedAtFallback</td>
                                <td>
                                    <button class="btn btn-sm btn-success btn-approve" data-id="@item.Id"
                                            data-entity-type="@item.EntityType">
                                        <i class="fas fa-check"></i> 通过
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger btn-reject" data-id="@item.Id"
                                            data-reason="数据质量不合格，拒绝同步">
                                        <i class="fas fa-times"></i> 拒绝
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">共 @totalPages 页 / @Model.TotalCount 条</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(1)">首页</a>
                                </li>
                                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(Model.PageIndex - 1)">&laquo;</a>
                                </li>
                                @{
                                    var rs = Math.Max(1, Model.PageIndex - 2);
                                    var re = Math.Min(totalPages, Model.PageIndex + 2);
                                }
                                @if (rs > 1) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                                @for (var i = rs; i <= re; i++)
                                {
                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                        <a class="page-link" href="@PageUrl(i)">@i</a>
                                    </li>
                                }
                                @if (re < totalPages) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                                <li class="page-item @(Model.PageIndex >= totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(Model.PageIndex + 1)">&raquo;</a>
                                </li>
                                <li class="page-item @(Model.PageIndex >= totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@PageUrl(totalPages)">尾页</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">审核通过</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="reviewFormTitle" class="text-muted small mb-2"></div>
                <form id="reviewForm">
                    <div class="row" id="reviewFields"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-success" id="btnConfirmApprove">
                    <i class="fas fa-check"></i> 审核通过
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var fieldLabels = {
            'code': '代码', 'name': '名称', 'country': '国家/地区', 'logoUrl': 'Logo 地址',
            'description': '描述', 'englishName': '英文名称', 'unifiedSocialCreditCode': '统一社会信用代码',
            'contactPerson': '联系人', 'contactPhone': '电话', 'contactMobile': '手机', 'contactQQ': 'QQ',
            'contactEmail': '邮箱', 'contactAddress': '地址', 'businessScope': '经营范围',
            'partNumber': '型号', 'oldNumber': '曾用代号', 'brandName': '品牌', 'bearingTypeName': '轴承类型',
            'innerDiameter': '内径', 'outerDiameter': '外径', 'width': '宽度', 'weight': '重量',
            'dynamicLoad': '动载荷 C', 'staticLoad': '静载荷 C0', 'limitingSpeed': '极限转速',
            'limitingSpeedGrease': '极限转速(脂)', 'limitingSpeedOil': '极限转速(油)',
            'priceDescription': '价格描述', 'minPrice': '最低价', 'maxPrice': '最高价', 'isNegotiable': '可议价',
            'image3DUrl': '3D 图地址', 'image2DUrl': '2D 图地址'
        };

        var currentAuditId = null;

        $('.btn-approve').on('click', function () {
            var btn = $(this);
            currentAuditId = btn.data('id');
            var entityType = btn.data('entity-type');

            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

            $.get('@Url.Action("GetDetail", "Review")', { id: currentAuditId })
                .done(function (res) {
                    if (res.success) {
                        var detail = res.data || {};
                        renderFields(detail.fields || {}, entityType);
                        $('#reviewFormTitle').text('实体类型：' + (entityType || '') + '，修改后点击审核通过，系统将按编辑后的数据入库');
                        $('#reviewModal').modal('show');
                    } else {
                        alert(res.message || '获取详情失败');
                    }
                })
                .always(function () {
                    btn.prop('disabled', false).html('<i class="fas fa-check"></i> 通过');
                });
        });

        function renderFields(fields, entityType) {
            var container = $('#reviewFields');
            container.empty();

            if (!fields || Object.keys(fields).length === 0) {
                container.html('<div class="text-muted">该记录无可用编辑字段，可直接审核通过</div>');
                return;
            }

            Object.keys(fields).forEach(function (key) {
                var label = fieldLabels[key] || key;
                var value = fields[key] || '';
                var col = document.createElement('div');
                col.className = 'col-md-6 mb-2';

                if (key === 'isNegotiable') {
                    var sel = document.createElement('select');
                    sel.className = 'form-select form-control-sm';
                    sel.name = key;
                    var option = document.createElement('option');
                    option.value = '';
                    option.text = '（未设置）';
                    sel.appendChild(option);
                    [['true', '是'], ['false', '否']].forEach(function (pair) {
                        var o = document.createElement('option');
                        o.value = pair[0];
                        o.text = pair[1];
                        if (value === pair[0]) o.selected = true;
                        sel.appendChild(o);
                    });
                    col.innerHTML = '<label class="form-label small mb-0">' + label + '</label>';
                    col.appendChild(sel);
                } else {
                    var input = document.createElement('input');
                    input.type = 'text';
                    input.className = 'form-control form-control-sm';
                    input.name = key;
                    input.value = value;
                    col.innerHTML = '<label class="form-label small mb-0">' + label + '</label>';
                    col.appendChild(input);
                }

                container.append(col);
            });
        }

        $('#btnConfirmApprove').on('click', function () {
            if (!currentAuditId) return;

            var btn = $(this);
            var fields = {};
            $('#reviewFields input, #reviewFields select').each(function () {
                fields[this.name] = $(this).val();
            });

            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

            $.ajax({
                url: '@Url.Action("Approve", "Review")',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ id: currentAuditId, fields: fields })
            }).done(function (res) {
                if (res.success) {
                    $('#reviewModal').modal('hide');
                    $('tr[data-review-id="' + currentAuditId + '"]').addClass('table-success').fadeOut(800, function () {
                        $(this).remove();
                    });
                } else {
                    alert(res.message || '操作失败');
                }
            }).fail(function () {
                alert('请求失败');
            }).always(function () {
                btn.prop('disabled', false).html('<i class="fas fa-check"></i> 审核通过');
            });
        });

        $('.btn-reject').on('click', function () {
            var btn = $(this);
            var id = btn.data('id');
            var reason = btn.data('reason') || '管理员拒绝';
            var row = btn.closest('tr');

            if (!confirm('确定拒绝此条审核记录吗？')) return;

            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

            $.post('@Url.Action("Reject", "Review")', { id: id, reason: reason })
                .done(function (res) {
                    if (res.success) {
                        row.addClass('table-danger').fadeOut(800, function () { row.remove(); });
                    } else {
                        alert(res.message || '操作失败');
                        btn.prop('disabled', false).html('<i class="fas fa-times"></i> 拒绝');
                    }
                })
                .fail(function () {
                    alert('请求失败');
                    btn.prop('disabled', false).html('<i class="fas fa-times"></i> 拒绝');
                });
        });
    </script>
}