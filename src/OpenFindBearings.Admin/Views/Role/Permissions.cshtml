@model IEnumerable<OpenFindBearings.Admin.Models.ViewModels.PermissionItemViewModel>
@using OpenFindBearings.Admin.Models.ViewModels
@{ ViewData["Title"] = "权限配置 - " + ViewBag.RoleName; }

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">权限配置 - <strong>@ViewBag.RoleName</strong></h6>
        <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
    </div>
    <div class="card-body">
        <form method="post" asp-action="SavePermissions" asp-route-roleName="@ViewBag.RoleName">
            <div class="row">
                @* 改动说明（v1.29.1）：原读 ViewBag.Items 而控制器 return View(catalog) 强类型 Model，
                   两者不通导致权限清单恒空；改用 Model 并补空态提示 *@
                @{
                    var permissions = Model ?? Enumerable.Empty<PermissionItemViewModel>();
                    var permGroups = permissions.GroupBy(p => GetGroup(p.Key));
                }
                @if (!permGroups.Any())
                {
                    <div class="col-12"><p class="text-muted mb-0">权限目录加载失败或为空（检查 API 连通性与 role.manage 权限）</p></div>
                }
                @foreach (var group in permGroups)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            @* 改动说明（v1.29.1）：去掉 bg-light——Bootstrap 浅色硬类在深色主题下
                               组标题白底刺眼且文字不可读，回归 site.css 主题化 card-header 默认样式 *@
                            <div class="card-header">
                                <h6 class="mb-0">@group.Key</h6>
                            </div>
                            <div class="card-body">
                                @foreach (var perm in group)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="grantedPermissions" value="@perm.Key"
                                               id="perm_@perm.Key"
                                               @(perm.Granted ? "checked" : "") />
                                        <label class="form-check-label" for="perm_@perm.Key">
                                            @(string.IsNullOrEmpty(perm.Description) ? perm.Key : perm.Description)
                                            <span class="text-muted small">@perm.Key</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">保存权限</button>
                <a asp-action="Index" class="btn btn-secondary">取消</a>
            </div>
        </form>
    </div>
</div>

@functions {
    // 改动说明（v1.30.0 权限目录重排）：组名由键前缀推导（与目录三段式天然对齐），
    // 展示名直读 API 权限表 Description——原逐键双 switch（37 键）随目录膨胀必漂移，废弃
    string GetGroup(string key) => key.Split('.')[0] switch
    {
        "dashboard" => "仪表盘",
        "bearing" or "brand" or "type" => "数据管理",
        "merchant" or "mapping" => "商家与映射",
        "data" => "数据危险操作",
        "review" or "correction" or "sourcing" => "审核管理",
        "sync" => "任务管理",
        "user" or "role" or "permission" => "认证管理",
        "system" or "points" => "系统配置",
        "audit" => "审计日志",
        _ => "其他"
    };
}
