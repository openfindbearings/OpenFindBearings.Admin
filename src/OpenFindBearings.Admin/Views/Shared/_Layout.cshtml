@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject System.Collections.Generic.IReadOnlyList<OpenFindBearings.Admin.Ext.IAdminModule> Modules
@{ 
    var identityAuth = Config["Identity:Authority"] ?? "https://localhost:7201";
    var clientId = Config["Identity:ClientId"] ?? "admin_client";
    var scope = Config["Identity:Scope"] ?? "openid profile email roles api:admin";
    var callbackUrl = Config["Identity:CallbackUrl"] ?? "https://localhost:7167/callback";
    var changePwdUrl = $"{identityAuth}/profile/change-password" +
        $"?returnUrl={Uri.EscapeDataString("https://localhost:7167/")}" +
        $"&realm=openfindbearings";
    var siteName = Config["SiteName"] ?? "OpenFindBearings";
    var siteDescription = Config["SiteDescription"] ?? "";
    // 改动说明（v1.25.0）：菜单按登录时写入的 permission 多值 claim 动态渲染（OR 命中）；
    //   panel_role=Admin 全显示（超管短路），与 Controller 的 PanelPermission 策略同口径；
    //   子视图按钮级判定用 Helpers.PanelPerms.Has(User, ...)（_ViewImports 不支持本块共享）
    var permSet = User.Claims.Where(c => c.Type == "permission").Select(c => c.Value).ToHashSet();
    bool HasPerm(params string[] perms) =>
        // 改动说明（v2.13.2 收敛）：超管角色名统一取 PanelRoles.Admin
        User.HasClaim(c => c.Type == "panel_role" && c.Value == PanelRoles.Admin) || perms.Any(p => permSet.Contains(p));
}
<!DOCTYPE html>
<html lang="zh-CN" data-bs-theme="light">
<head>
    @* 改动说明（v1.31.1）：BS5.3 原生 data-bs-theme 暗色模式 + 内联引导脚本——
       在 CSS 加载前定主题属性，根治 alert/list-group/dropdown 等全族组件白底并防白闪 *@
    <script>if ((localStorage.getItem('theme') || 'light') === 'dark') { document.documentElement.setAttribute('data-bs-theme', 'dark'); }</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <a asp-controller="Home" asp-action="Index">
                @siteName
                @if (!string.IsNullOrEmpty(siteDescription))
                {
                    <small class="d-block text-muted" style="font-size:0.7em;font-weight:normal">@siteDescription</small>
                }
            </a>
        </div>
        <nav class="sidebar-nav">
            <ul>
                @if (HasPerm("dashboard.view"))
                {
                <li>
                    <a asp-controller="Home" asp-action="Index" class="nav-link" data-page="home">
                        <i class="fas fa-tachometer-alt"></i><span>仪表盘</span>
                    </a>
                </li>
                }
                @* 改动说明（v2.16.0 替代品治理）：替代品管理入口归入信息管理（平台建标准），
                   外组条件补权限键保证仅持该权限者也能见到本组 *@
                @* 改动说明（v2.17.0 替代品字典化）：替代品改用 interchange.view，外组条件随之替换
                   （merchant.verify 已无本组条目依赖，去除避免僵尸条件） *@
                @if (HasPerm("bearing.view", "brand.view", "type.view", "merchant.view", "interchange.view"))
                {
                <li class="has-sub">
                    <a href="#" class="nav-link toggle-sub" data-target="sub-info">
                        <i class="fas fa-database"></i><span>信息管理</span><i class="fas fa-chevron-right arrow"></i>
                    </a>
                    <ul class="sub-menu" id="sub-info">
                        <li class="sub-header">基础信息</li>
                        @if (HasPerm("brand.view"))
                        {
                        <li><a asp-controller="Data" asp-action="Brands" class="nav-link" data-page="data-brands"><i class="fas fa-circle"></i><span>品牌列表</span></a></li>
                        }
                        @if (HasPerm("type.view"))
                        {
                        <li><a asp-controller="Data" asp-action="BearingTypes" class="nav-link" data-page="data-types"><i class="fas fa-circle"></i><span>类型列表</span></a></li>
                        }
                        @if (HasPerm("bearing.view"))
                        {
                        <li><a asp-controller="Data" asp-action="Bearings" class="nav-link" data-page="data-bearings"><i class="fas fa-circle"></i><span>轴承列表</span></a></li>
                        }
                        @* 改动说明（v2.16.0 替代品治理）：平台替代关系管理入口，与轴承列表同置基础信息区 *@
                        @* 改动说明（v2.17.0 替代品字典化）：替代关系属主数据，权限由 merchant.verify 改为 interchange.view *@
                        @if (HasPerm("interchange.view"))
                        {
                        <li><a asp-controller="Interchanges" asp-action="Index" class="nav-link" data-page="interchanges"><i class="fas fa-circle"></i><span>替代品管理</span></a></li>
                        }
                        @if (HasPerm("merchant.view"))
                        {
                        <li><a asp-controller="Data" asp-action="Merchants" class="nav-link" data-page="data-merchants"><i class="fas fa-circle"></i><span>商家列表</span></a></li>
                        }
                    </ul>
                </li>
                }
                @if (HasPerm("correction.review", "merchant.verify", "sourcing.view"))
                {
                <li class="has-sub">
                    <a href="#" class="nav-link toggle-sub" data-target="sub-review">
                        <i class="fas fa-check-double"></i><span>审核管理</span><i class="fas fa-chevron-right arrow"></i>
                    </a>
                    <ul class="sub-menu" id="sub-review">
                        @if (HasPerm("correction.review"))
                        {
                        <li><a asp-controller="Correction" asp-action="Index" class="nav-link" data-page="correction"><i class="fas fa-circle"></i><span>信息纠错审核</span></a></li>
                        }
                        @if (HasPerm("merchant.verify"))
                        {
                    @* 改动说明：应运营要求，入驻申请审批前置到证照材料审核之前（主链路优先）；v2.7.0 执照审核泛化为证照材料队列 *@
                    <li><a asp-controller="MerchantVerify" asp-action="Index" class="nav-link" data-page="merchant-verify"><i class="fas fa-circle"></i><span>入驻申请审批</span></a></li>
                        <li><a asp-controller="Document" asp-action="Index" class="nav-link" data-page="document"><i class="fas fa-circle"></i><span>证照材料审核</span></a></li>
                        @* 改动说明（v2.15.0 商品审核）：商家上架商品人工审核入口，与入驻/证照审核同置 merchant.verify 组 *@
                        <li><a asp-controller="MerchantBearingReview" asp-action="Index" class="nav-link" data-page="merchant-bearing-review"><i class="fas fa-circle"></i><span>商品审核</span></a></li>
                        @* 改动说明（v2.16.0 替代品治理）：商家替代候选审核入口，与商品审核同置 merchant.verify 组 *@
                        @* 改动说明（v2.17.0 替代品字典化）：删除"替代品审核"入口（商家候选流取消） *@
                        }
                        @* 改动说明（v2.19.0）：寻货管理页此前无侧边栏入口、后台无法进入；补入口，按 sourcing.view 显示 *@
                        @if (HasPerm("sourcing.view"))
                        {
                        <li><a asp-controller="Sourcing" asp-action="Index" class="nav-link" data-page="sourcing"><i class="fas fa-circle"></i><span>寻货管理</span></a></li>
                        }
                        @* 改动说明（v2.18.0 通用扩展点）：并入扩展模块声明在"审核"分组的菜单项（开源无模块=无） *@
                        @foreach (var module in Modules)
                        {
                            foreach (var item in module.MenuItems.Where(i => i.Group == "审核"))
                            {
                                if (item.Permission == null || HasPerm(item.Permission))
                                {
                        <li><a asp-controller="@item.Controller" asp-action="@item.Action" class="nav-link" data-page="@item.Controller.ToLowerInvariant()"><i class="fas @item.Icon"></i><span>@item.Label</span></a></li>
                                }
                            }
                        }
                    </ul>
                </li>
                }
                @if (HasPerm("user.view", "user.manage", "role.manage"))
                {
                <li class="has-sub">
                    <a href="#" class="nav-link toggle-sub" data-target="sub-auth">
                        <i class="fas fa-shield-alt"></i><span>认证管理</span><i class="fas fa-chevron-right arrow"></i>
                    </a>
                    <ul class="sub-menu" id="sub-auth">
                        @if (HasPerm("user.view"))
                        {
                        <li><a asp-controller="Users" asp-action="Index" class="nav-link" data-page="users"><i class="fas fa-circle"></i><span>用户管理</span></a></li>
                        }
                        @if (HasPerm("role.manage"))
                        {
                        <li><a asp-controller="Role" asp-action="Index" class="nav-link" data-page="role"><i class="fas fa-circle"></i><span>角色管理</span></a></li>
                        }
                        @if (HasPerm("permission.view"))
                        {
                        <li><a asp-controller="Permission" asp-action="Index" class="nav-link" data-page="permission"><i class="fas fa-circle"></i><span>权限管理</span></a></li>
                        }
                    </ul>
                </li>
                }
                @if (HasPerm("system.view"))
                {
                @* 改动说明（v2.6.0 菜单次序）：勋章管理/商城管理提到审计日志前，
                   审计日志与系统配置恒居末尾（业务功能优先、审计与配置殿后） *@
                <li>
                    <a asp-controller="Achievement" asp-action="Index" class="nav-link" data-page="achievement">
                        <i class="fas fa-trophy"></i><span>勋章管理</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Mall" asp-action="Index" class="nav-link" data-page="mall">
                        <i class="fas fa-store"></i><span>商城管理</span>
                    </a>
                </li>
                }
                @if (HasPerm("audit.view"))
                {
                <li class="has-sub">
                    <a href="#" class="nav-link toggle-sub" data-target="sub-audit">
                        <i class="fas fa-history"></i><span>审计日志</span><i class="fas fa-chevron-right arrow"></i>
                    </a>
                    <ul class="sub-menu" id="sub-audit">
                        <li><a asp-controller="AuditLog" asp-action="Index" asp-route-source="identity" class="nav-link" data-page="auditlog-identity"><i class="fas fa-circle"></i><span>管理员日志</span></a></li>
                        <li><a asp-controller="AuditLog" asp-action="Index" asp-route-source="api" class="nav-link" data-page="auditlog-api"><i class="fas fa-circle"></i><span>API 日志</span></a></li>
                        @* 改动说明（v2.13.2 死链修复）：开源版不含该数据源，控制器/视图亦无各数据源，
                           原该日志菜单项点击落到空列表，删除 *@
                    </ul>
                </li>
                }
                @if (HasPerm("system.view"))
                {
                <li>
                    <a asp-controller="Config" asp-action="Index" class="nav-link" data-page="config">
                        <i class="fas fa-cog"></i><span>系统配置</span>
                    </a>
                </li>
                }
                @* 改动说明（v2.18.0 通用扩展点）：扩展模块菜单——无分组=顶层项；有分组=按组渲染为 has-sub 分组（开源无模块=无） *@
                @{
                    var moduleMenuItems = Modules.SelectMany(m => m.MenuItems).Where(i => i.Group != "审核").ToList();
                    var moduleTopItems = moduleMenuItems.Where(i => string.IsNullOrEmpty(i.Group)).ToList();
                    var moduleGroups = moduleMenuItems.Where(i => !string.IsNullOrEmpty(i.Group)).GroupBy(i => i.Group).ToList();
                    var moduleGroupIndex = 0;
                }
                @foreach (var item in moduleTopItems)
                {
                    if (item.Permission == null || HasPerm(item.Permission))
                    {
                <li><a asp-controller="@item.Controller" asp-action="@item.Action" class="nav-link" data-page="@item.Controller.ToLowerInvariant()"><i class="fas @item.Icon"></i><span>@item.Label</span></a></li>
                    }
                }
                @foreach (var grp in moduleGroups)
                {
                    var grpFirst = grp.First();
                    if (grp.Any(i => i.Permission == null || HasPerm(i.Permission)))
                    {
                        var grpTarget = "sub-mod-" + (moduleGroupIndex++);
                <li class="has-sub">
                    <a href="#" class="nav-link toggle-sub" data-target="@grpTarget">
                        <i class="fas @(grpFirst.GroupIcon ?? "fa-folder")"></i><span>@(grpFirst.GroupLabel ?? grp.Key)</span><i class="fas fa-chevron-right arrow"></i>
                    </a>
                    <ul class="sub-menu" id="@grpTarget">
                        @foreach (var item in grp)
                        {
                            if (item.Permission == null || HasPerm(item.Permission))
                            {
                        <li><a asp-controller="@item.Controller" asp-action="@item.Action" class="nav-link" data-page="@item.Controller.ToLowerInvariant()"><i class="fas @item.Icon"></i><span>@item.Label</span></a></li>
                            }
                        }
                    </ul>
                </li>
                    }
                }
            </ul>
        </nav>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="main-content">
        <header class="topbar">
            <button class="btn btn-link sidebar-toggle" id="sidebarToggle">
                <i class="fas fa-bars"></i>
            </button>
            <div class="topbar-right">
                <div class="service-status" id="serviceStatus">
                    <span class="service-item"><span class="service-dot"></span>检测中...</span>
                </div>
                <button class="theme-toggle" id="themeToggle" title="切换主题">
                    <i class="fas fa-moon" id="themeIcon"></i>
                </button>
                <div class="dropdown user-dropdown">
                    <a href="#" class="user-avatar" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-user-circle"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fas fa-id-card"></i><span>个人信息</span></a></li>
                        <li><a class="dropdown-item" href="@changePwdUrl" target="_top"><i class="fas fa-key"></i><span>修改密码</span></a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt"></i><span>退出登录</span></a></li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="content-wrap">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>

        <footer class="main-footer">
            @* 改动说明（v2.19.0）：页脚年份统一取 UTC，原 DateTime.Now 违反全项目时间与时区规则（禁止服务层取本地时间） *@
            <strong>@siteName</strong> &copy; @DateTime.UtcNow.Year
            @if (!string.IsNullOrEmpty(siteDescription))
            {
                <span class="text-muted ms-2">@siteDescription</span>
            }
        </footer>
    </div>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* v1.22.0：全站统一弹窗体系（showConfirm/showPrompt/showToast + data-confirm 委托） *@
    <script src="~/js/dialogs.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @* 改动说明：全局 UTC→本地时间转换，使用浏览器原生 Intl.DateTimeFormat，不依赖任何 CDN *@
    <script>
        (function () {
            var _browserTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            var _fmt = new Intl.DateTimeFormat("zh-CN", {
                timeZone: _browserTz,
                year: "numeric", month: "2-digit", day: "2-digit",
                hour: "2-digit", minute: "2-digit", hour12: false
            });
            function fmtUtc(v) {
                if (!v) return null;
                var s = v;
                // 改动说明（v2.13.2）：截断 >3 位小数秒（.NET "O"/cookie expires_at 含 7 位），
                //   否则部分引擎 new Date 解析失败；统一全局转换器能兜住所有 data-utc 消费点
                if (typeof s === "string") s = s.replace(/(\.\d{3})\d+/, "$1");
                if (typeof s === "string" && !/Z$|[+-]\d{2}:\d{2}$/.test(s)) s = s + "Z";
                return _fmt.format(new Date(s));
            }
            document.addEventListener("DOMContentLoaded", function () {
                document.querySelectorAll("[data-utc]").forEach(function (el) {
                    var r = fmtUtc(el.getAttribute("data-utc"));
                    if (r) el.textContent = r;
                });
            });
        })();
    </script>
</body>
</html>
