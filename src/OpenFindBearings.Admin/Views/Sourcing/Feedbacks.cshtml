@{
    ViewData["Title"] = "成交回执";
    var items = ViewBag.Items as List<OpenFindBearings.Admin.Controllers.SourcingFeedbackDto> ?? [];
    Guid? merchantId = ViewBag.MerchantId;
    int? outcome = ViewBag.Outcome;
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 20;
    int total = ViewBag.Total ?? 0;
    int totalPages = (int)Math.Ceiling((double)total / pageSize);
    var outcomeNames = new Dictionary<int, string>
    {
        [0] = "谈成",
        [1] = "没货",
        [2] = "加价",
        [3] = "拖延",
        [4] = "其他"
    };
    // 分页统一保留商户与结果筛选
    string PageUrl(int p) => $"?merchantId={merchantId}&outcome={outcome}&page={p}&pageSize={pageSize}";
}

<div class="page-header">
    <h4><i class="fas fa-handshake"></i> 成交回执</h4>
    <p class="text-muted">需求方对选定应答的成交反馈；撤销/恢复计分会重算商家卡级并记录复核留痕</p>
</div>

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h6 class="mb-0">回执记录 <small class="text-muted">(@total 条)</small></h6>
        <form class="d-flex flex-wrap gap-2 align-items-center" method="get">
            <input type="text" name="merchantId" value="@merchantId" class="form-control form-control-sm" style="width:260px" placeholder="商户 ID（可选）" />
            <select name="outcome" class="form-select form-select-sm" style="width:140px">
                <option value="" selected="@(outcome == null ? "selected" : null)">全部结果</option>
                @foreach (var kv in outcomeNames)
                {
                    <option value="@kv.Key" selected="@(outcome == kv.Key ? "selected" : null)">@kv.Key @kv.Value</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i></button>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>轴承型号</th>
                        <th>需求方</th>
                        <th>商家</th>
                        <th>结果</th>
                        <th>是否计分</th>
                        <th>未计分原因/复核留痕</th>
                        <th class="text-nowrap">回执时间</th>
                        <th style="width:140px">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (items.Count > 0)
                    {
                        @foreach (var item in items)
                        {
                            <tr>
                                <td><strong>@(string.IsNullOrWhiteSpace(item.PartNumber) ? "-" : item.PartNumber)</strong></td>
                                <td>
                                    @(item.PublisherName ?? "-")
                                    @if (!string.IsNullOrWhiteSpace(item.PublisherMerchantName))
                                    {
                                        <div><small class="text-muted">@item.PublisherMerchantName</small></div>
                                    }
                                </td>
                                <td>@(item.MerchantName ?? "-")</td>
                                <td><span class="badge @(item.Outcome == 0 ? "bg-success" : "bg-secondary")">@(item.OutcomeLabel ?? outcomeNames.GetValueOrDefault(item.Outcome, "未知"))</span></td>
                                <td>
                                    @if (item.Counted)
                                    {
                                        <span class="badge bg-success">是</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">否</span>
                                    }
                                </td>
                                <td>
                                    <small>@(item.Reason ?? "-")</small>
                                    @if (!string.IsNullOrWhiteSpace(item.FlagNote))
                                    {
                                        <div><small class="text-muted">@item.FlagNote</small></div>
                                    }
                                </td>
                                @* 展示层统一由全局 data-utc 转换器按浏览器时区渲染 *@
                                <td class="text-nowrap small" data-utc="@(item.FeedbackAt?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? "")">@(item.FeedbackAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td>
                                    @if (PanelPerms.Has(User, "merchant.grade.manage"))
                                    {
                                        <button type="button"
                                                class="btn btn-sm @(item.Counted ? "btn-outline-danger" : "btn-outline-success") btn-revoke"
                                                data-response-id="@item.ResponseId"
                                                data-counted="@(item.Counted ? "true" : "false")"
                                                data-part-number="@item.PartNumber">
                                            <i class="fas @(item.Counted ? "fa-rotate-left" : "fa-check")"></i>
                                            <span class="d-none d-sm-inline">@(item.Counted ? "撤销计分" : "恢复计分")</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">暂无成交回执</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">共 @totalPages 页 / @total 条</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(1)">首页</a>
                        </li>
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(page - 1)">&laquo;</a>
                        </li>
                        @{
                            var rs = Math.Max(1, page - 2);
                            var re = Math.Min(totalPages, page + 2);
                        }
                        @if (rs > 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        @for (var p = rs; p <= re; p++)
                        {
                            <li class="page-item @(p == page ? "active" : "")">
                                <a class="page-link" href="@PageUrl(p)">@p</a>
                            </li>
                        }
                        @if (re < totalPages)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(page + 1)">&raquo;</a>
                        </li>
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(totalPages)">尾页</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // 撤销/恢复计分：先弹原因输入（写入复核留痕），再代理 API 翻转计分并刷新列表
        $('.btn-revoke').on('click', async function () {
            const responseId = $(this).data('response-id');
            const counted = $(this).data('counted') === true;
            const partNumber = $(this).data('part-number') || '';
            const targetCounted = !counted;
            const actionName = targetCounted ? '恢复计分' : '撤销计分';
            const reason = await showPrompt({
                title: `${actionName}「${partNumber}」`,
                placeholder: '复核原因（将写入留痕）',
                confirmText: actionName,
                danger: !targetCounted
            });
            if (reason === null || reason === undefined) return;
            $.post('@Url.Action("RevokeFeedback")',
                { responseId: responseId, counted: targetCounted, reason: reason || '' },
                function (r) {
                    showToast(r.success ? 'success' : 'error', r.message || (r.success ? '操作成功' : '操作失败'));
                    if (r.success) setTimeout(() => location.reload(), 600);
                }).fail(function () {
                    showToast('error', '服务异常');
                });
        });
    </script>
}
