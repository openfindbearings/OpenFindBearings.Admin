@{
    ViewData["Title"] = "ETL 同步";
    // 首屏数据（来自控制器预取，失败则为 null，由前端轮询代理端点补充）
    var initialSummaryJson = ViewBag.EtlSummaryJson as string;
    var initialTasksJson = ViewBag.EtlTasksJson as string;
}

<div class="row mb-3">
    <div class="col-12">
        <h4 class="mb-0">ETL 同步管理</h4>
        <small class="text-muted">当前 Sync 状态: <strong id="syncStatus">@(ViewBag.SyncStatus ?? "未知")</strong></small>
    </div>
</div>

<!-- 运行态卡片 -->
<div class="row mb-3" id="phaseCards">
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">Extract 抽取</h6></div>
            <div class="card-body">
                <span class="badge" id="badge-Extract">--</span>
                <div class="small text-muted mt-2" id="desc-Extract">--</div>
                <form method="post" asp-action="Trigger" asp-route-phase="extract" class="mt-2">
                    <button type="submit" class="btn btn-outline-primary w-100 btn-trigger" data-phase="Extract">触发 Extract</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">Transform 转换</h6></div>
            <div class="card-body">
                <span class="badge" id="badge-Transform">--</span>
                <div class="small text-muted mt-2" id="desc-Transform">--</div>
                <form method="post" asp-action="Trigger" asp-route-phase="transform" class="mt-2">
                    <button type="submit" class="btn btn-outline-primary w-100 btn-trigger" data-phase="Transform">触发 Transform</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">Images 图片</h6></div>
            <div class="card-body">
                <span class="badge" id="badge-Images">--</span>
                <div class="small text-muted mt-2" id="desc-Images">--</div>
                <form method="post" asp-action="Trigger" asp-route-phase="images" class="mt-2">
                    <button type="submit" class="btn btn-outline-primary w-100 btn-trigger" data-phase="Images">触发 Images</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">Load 加载</h6></div>
            <div class="card-body">
                <span class="badge" id="badge-Load">--</span>
                <div class="small text-muted mt-2" id="desc-Load">--</div>
                <form method="post" asp-action="Trigger" asp-route-phase="load" class="mt-2">
                    <button type="submit" class="btn btn-outline-primary w-100 btn-trigger" data-phase="Load">触发 Load</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 完整流程触发 + 调度说明 -->
<div class="row mb-3">
    <div class="col-md-4 mb-2">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">完整流程</h6></div>
            <div class="card-body">
                <p class="small text-muted mb-2">依次创建 抽取 → 转换 → 图片 → 加载 任务。任一批次正在进行或排队时禁止重复触发（含定时调度）。</p>
                <form method="post" asp-action="Trigger" asp-route-phase="run">
                    <button type="submit" class="btn btn-primary w-100 btn-trigger" data-phase="Full">触发全量 ETL</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8 mb-2">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">ETL 调度说明</h6></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <thead><tr><th>阶段</th><th>调度时间（北京时间）</th><th>说明</th></tr></thead>
                    <tbody>
                        <tr><td>Extract</td><td>每日 12:00</td><td>从 db_raw 提取数据到 staging 表</td></tr>
                        <tr><td>Transform</td><td>每日 12:30</td><td>数据清洗、映射、评分</td></tr>
                        <tr><td>Images</td><td>每日 13:00</td><td>异步下载商品图片</td></tr>
                        <tr><td>Load</td><td>每日 13:30</td><td>加载到 API 业务库</td></tr>
                        <tr><td>Retry</td><td>每日 14:30</td><td>重试失败记录</td></tr>
                        <tr><td>Stuck</td><td>每日 15:00</td><td>处理卡住记录</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 最近执行记录 -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                <h6 class="mb-0">最近执行记录</h6>
                <div class="d-flex gap-2 mt-2 mt-md-0">
                    <select id="filterPhase" class="form-select form-select-sm" style="width:auto;">
                        <option value="">全部阶段</option>
                        <option value="Extract">Extract</option>
                        <option value="Transform">Transform</option>
                        <option value="Images">Images</option>
                        <option value="Load">Load</option>
                        <option value="Retry">Retry</option>
                        <option value="Stuck">Stuck</option>
                    </select>
                    <button id="refreshBtn" class="btn btn-sm btn-outline-secondary">刷新</button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>阶段</th><th>状态</th><th>开始时间</th><th>结束时间</th>
                                <th>成功</th><th>失败</th><th>跳过</th><th>错误信息</th>
                            </tr>
                        </thead>
                        <tbody id="taskRows">
                            <tr><td colspan="8" class="text-center text-muted">加载中...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 首屏数据（控制器预取的 JSON 字符串，可能为 null）
    const initialSummary = @Html.Raw(initialSummaryJson ?? "null");
    const initialTasks = @Html.Raw(initialTasksJson ?? "null");

    function fmtTime(v) {
        if (!v) return "-";
        const s = (typeof v === "string" && !/Z$|[+-]\d{2}:\d{2}$/.test(v)) ? v + "Z" : v;
        const d = new Date(s);
        if (isNaN(d)) return "-";
        return d.toLocaleString(undefined, {
            year: "numeric", month: "2-digit", day: "2-digit",
            hour: "2-digit", minute: "2-digit"
        });
    }

    function statusBadge(text, kind) {
        return `<span class="badge bg-${kind}">${text}</span>`;
    }

    // 根据阶段运行态设置卡片 + 触发按钮禁用状态与提示
    function applyPhase(phase) {
        const cmd = phase.commandType;
        const badge = document.getElementById("badge-" + cmd);
        const desc = document.getElementById("desc-" + cmd);
        if (!badge || !desc) return;

        if (phase.isActive) {
            badge.className = "badge bg-warning";
            badge.textContent = "进行中/排队中";
        } else {
            badge.className = "badge bg-secondary";
            badge.textContent = "空闲";
        }
        desc.textContent = "最近: " + (phase.latestStatus || "-")
            + (phase.latestStartedAt ? " " + fmtTime(phase.latestStartedAt) : "");
    }

    // 触发按钮禁用：某阶段活跃则禁用对应按钮；完整流程在任一阶段活跃时禁用
    function applyButtons(summary) {
        const active = new Set((summary.phases || [])
            .filter(p => p.isActive)
            .map(p => p.commandType));
        const blockMsg = "该阶段当前有进行中或排队中的任务（可能来自定时调度），暂不能手动执行，请稍后重试。";
        document.querySelectorAll(".btn-trigger").forEach(btn => {
            const phase = btn.getAttribute("data-phase");
            let disabled = false;
            if (phase === "Full") {
                disabled = active.size > 0;
            } else if (active.has(phase)) {
                disabled = true;
            }
            btn.disabled = disabled;
            btn.title = disabled ? blockMsg : "";
        });
    }

    function renderSummary(summary) {
        if (!summary) return;
        (summary.phases || []).forEach(applyPhase);
        applyButtons(summary);
    }

    function renderTasks(data) {
        const tbody = document.getElementById("taskRows");
        if (!tbody) return;
        const items = (data && data.items) ? data.items : (Array.isArray(data) ? data : []);
        if (!items.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">暂无执行记录</td></tr>';
            return;
        }
        const rows = items.map(t => {
            const status = (t.status || "").toLowerCase();
            let kind = "secondary";
            if (status === "running") kind = "warning";
            else if (status === "success") kind = "success";
            else if (status === "failed") kind = "danger";
            else if (status === "pending") kind = "info";
            const err = t.errorMessage ? (t.errorMessage.length > 40 ? t.errorMessage.substring(0, 40) + "..." : t.errorMessage) : "-";
            return `<tr>
                <td>${t.commandType || "-"}</td>
                <td>${statusBadge(t.status || "-", kind)}</td>
                <td>${fmtTime(t.startedAt)}</td>
                <td>${fmtTime(t.completedAt)}</td>
                <td>${t.successRecords ?? 0}</td>
                <td>${t.failedRecords ?? 0}</td>
                <td>${t.skippedRecords ?? 0}</td>
                <td title="${t.errorMessage || ""}">${err}</td>
            </tr>`;
        }).join("");
        tbody.innerHTML = rows;
    }

    function unwrap(resp) {
        return resp && resp.data !== undefined ? resp.data : resp;
    }

    async function loadSummary() {
        try {
            const r = await fetch("/api/proxy/etl/summary");
            if (!r.ok) {
                document.getElementById("syncStatus").textContent = "离线 (HTTP " + r.status + ")";
                return;
            }
            document.getElementById("syncStatus").textContent = "在线";
            const j = await r.json();
            renderSummary(unwrap(j));
        } catch (e) {
            document.getElementById("syncStatus").textContent = "离线 (连接失败)";
        }
    }

    async function loadTasks() {
        const phase = document.getElementById("filterPhase").value;
        const url = "/api/proxy/etl/tasks?page=1&pageSize=20" + (phase ? ("&commandType=" + phase) : "");
        try {
            const r = await fetch(url);
            if (!r.ok) return;
            const j = await r.json();
            renderTasks(unwrap(j));
        } catch (e) { /* 忽略 */ }
    }

    // 首屏渲染
    if (initialSummary) renderSummary(unwrap(initialSummary));
    if (initialTasks) renderTasks(unwrap(initialTasks));
    else loadTasks();

    // 轮询刷新
    setInterval(loadSummary, 15000);
    setInterval(loadTasks, 15000);
    document.getElementById("refreshBtn").addEventListener("click", () => { loadSummary(); loadTasks(); });
    document.getElementById("filterPhase").addEventListener("change", loadTasks);
</script>
}
