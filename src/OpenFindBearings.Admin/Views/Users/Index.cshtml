@using OpenFindBearings.Admin.Models.DTOs
@{
    ViewData["Title"] = "用户管理";
    // 改动说明：ViewBag 改用 ?? 兜底。原实现在 API 调用失败时 Page/PageSize/TotalCount 全为 null，
    //           强转 int 后 pageSize 为 0，下方 totalCount/pageSize 触发除零 → 强转 int(NaN) 抛
    //           InvalidOperationException，整个页面崩溃。改为统一用 ?? 兜底后，
    //           API 失败时安全显示空列表与"暂无数据"
    var search = (string?)ViewBag.Search ?? "";
    var page = ViewBag.Page as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 20;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var includeDeleted = (bool)(ViewBag.IncludeDeleted ?? false);
    var totalPages = totalCount > 0 && pageSize > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;
    // 改动说明（v1.29.2）：URL ?tab= 决定初始页签（all/panel/app，默认 panel），操作回跳与翻页保持
    var currentTab = (string?)ViewBag.Tab;
    if (currentTab != "all" && currentTab != "app") currentTab = "panel";
    string PageUrl(int p) => $"?page={p}&pageSize={pageSize}&search={Uri.EscapeDataString(search)}&includeDeleted={includeDeleted.ToString().ToLower()}&tab={currentTab}";
    // 改动说明：输出 UTC ISO 8601 字符串，由全局 data-utc JS 按浏览器时区显示
    string BdTimeRaw(DateTimeOffset? dt) => dt.HasValue ? dt.Value.ToString("yyyy-MM-ddTHH:mm:ssZ") : "从未";
    // 改动说明（v1.29.0）：角色列数据源从 Identity Roles（恒空，认证中心角色与业务无关）
    // 切换为 API 平台角色字典 sub→roles[]；后台角色=Admin/Operator/Auditor，仅 Individual 者归"App 用户"
    var platformRoles = ViewBag.PlatformRoles as Dictionary<string, List<string>> ?? new();
    // 改动说明（v1.29.0）：角色徽章显示 API 目录里的中文显示名（DisplayName ?? Name）
    var roleDisplayNames = ViewBag.RoleDisplayNames as Dictionary<string, string> ?? new(StringComparer.OrdinalIgnoreCase);
    string[] panelRoleNames = ["Admin", "Operator", "Auditor"];
    string RoleBadgeClass(string r) => r switch { "Admin" => "bg-success", "Operator" => "bg-primary", "Auditor" => "bg-warning text-dark", _ => "bg-secondary" };
    string RoleBadgeText(string r) => roleDisplayNames.TryGetValue(r, out var dn) ? dn : (r == "Individual" ? "普通用户" : r);
}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h6 class="mb-0">用户管理 <small class="text-muted">(@totalCount 条)</small></h6>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">新建用户</span>
            </button>
            <form class="d-flex gap-2 align-items-center flex-nowrap" method="get">
                @* 改动说明（v1.29.2）：搜索 GET 表单带上当前页签，搜索后不跳回默认 tab *@
                <input type="hidden" name="tab" value="@currentTab" />
                <input type="text" name="search" value="@search" class="form-control" placeholder="搜索用户..." style="min-width:140px" />
                <div class="form-check d-none d-sm-block" style="white-space:nowrap">
                    <input class="form-check-input" type="checkbox" name="includeDeleted" value="true" id="includeDeleted" @(includeDeleted ? "checked" : "") onchange="this.form.submit()" />
                    <label class="form-check-label" for="includeDeleted">显示已删除</label>
                </div>
                <button class="btn btn-primary"><i class="fas fa-search"></i></button>
            </form>
        </div>
    </div>
    @* 改动说明（v1.29.1）：本菜单语义=后台用户管理，默认页签从"全部"改为"后台用户"；
       页签区分后台用户与 App 用户（当前页客户端过滤，分页仍走服务端）；
       分类依据=API 平台角色：挂 Admin/Operator/Auditor 任一为后台用户，否则归 App 用户 *@
    <ul class="nav ofb-tabs px-2" id="userTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(currentTab == "all" ? "active" : "")" data-utab="all" type="button">全部</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(currentTab == "panel" ? "active" : "")" data-utab="panel" type="button">后台用户</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(currentTab == "app" ? "active" : "")" data-utab="app" type="button">前端用户</button>
        </li>
    </ul>
    <div class="card-body p-0">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>用户名</th>
                    <th>姓名</th>
                    <th>邮箱</th>
                    <th>手机号</th>
                    <th>状态</th>
                    <th>角色</th>
                    <th>最后登录</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @{ var items = ViewBag.Items as IEnumerable<UserItemDto> ?? Enumerable.Empty<UserItemDto>(); }
                @if (items.Any())
                {
                    @foreach (var item in items)
                    {
                        var roles = platformRoles.TryGetValue(item.Id.ToString(), out var rr) ? rr : new List<string>();
                        // 改动说明（v1.29.2）：三态分类——有后台角色=panel、有 Individual=app、
                        // 无任何角色=none（后台建的号未分配/未登录过，不算 App 用户，只在"全部"显示）
                        var utype = roles.Any(r => panelRoleNames.Contains(r)) ? "panel"
                            : roles.Contains("Individual") ? "app" : "none";
                        <tr data-utype="@utype">
                            <td>@item.UserName</td>
                            <td>@(item.Name ?? "-")</td>
                            <td>@(item.Email ?? "-")</td>
                            <td>@(item.PhoneNumber ?? "-")</td>
                            <td>
                                @if (!item.IsActive)
                                {
                                    <span class="badge bg-danger">已删除</span>
                                }
                                else if (!item.IsEnabled)
                                {
                                    <span class="badge bg-warning text-dark">已禁用</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">正常</span>
                                }
                            </td>
                            @* 改动说明（v1.29.0）：原渲染 item.Roles（Identity 角色，恒空）；
                               改渲染 API 平台角色徽章，未 JIT 用户显示"-"，仅 Individual 显示"App 用户"灰徽章 *@
                            <td>
                                @if (roles.Any())
                                {
                                    @foreach (var r in roles)
                                    {
                                        <span class="badge @RoleBadgeClass(r) mb-1">@RoleBadgeText(r)</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td data-utc="@BdTimeRaw(item.LastLoginAt)">@BdTimeRaw(item.LastLoginAt)</td>
                            <td>
                                @if (!item.IsActive)
                                {
                                    <form method="post" asp-action="Restore" asp-route-id="@item.Id" class="d-inline" data-confirm="确认恢复该用户？"><input type="hidden" name="tab" value="@currentTab" />
                                        <button class="btn btn-sm btn-outline-success">恢复</button>
                                    </form>
                                    <form method="post" asp-action="HardDelete" asp-route-id="@item.Id" data-confirm="此操作不可恢复，确定要彻底删除该用户吗？" data-confirm-danger><input type="hidden" name="tab" value="@currentTab" />
                                        <button class="btn btn-sm btn-outline-danger">彻底删除</button>
                                    </form>
                                }
                                else
                                {
                                    @* 改动说明（v1.29.2）：显式传目标态 enable（当前取反）+ 回跳 tab 保持 *@
                                    <form method="post" asp-action="ToggleStatus" asp-route-id="@item.Id" class="d-inline">
                                        <input type="hidden" name="enable" value="@((!item.IsEnabled).ToString().ToLower())" />
                                        <input type="hidden" name="tab" value="@currentTab" />
                                        <button class="btn btn-sm btn-outline-@(item.IsEnabled ? "danger" : "success")">@(item.IsEnabled ? "禁用" : "启用")</button>
                                    </form>
                                    <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#resetPwdModal" data-id="@item.Id" data-name="@item.UserName">重置密码</button>
                                    @* v1.25.0 平台角色分配入口（API RBAC，与 Identity 角色列分离） *@
                                    <button class="btn btn-sm btn-outline-secondary btn-platform-roles" data-bs-toggle="modal" data-bs-target="#platformRolesModal" data-id="@item.Id" data-name="@item.UserName">平台角色</button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">暂无数据</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">共 @totalPages 页 / @totalCount 条</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(1)">首页</a>
                        </li>
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(page - 1)">&laquo;</a>
                        </li>
                        @{
                            var rangeStart = Math.Max(1, page - 2);
                            var rangeEnd = Math.Min(totalPages, page + 2);
                            if (rangeStart > 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            for (var i = rangeStart; i <= rangeEnd; i++)
                            {
                                <li class="page-item @(i == page ? "active" : "")">
                                    <a class="page-link" href="@PageUrl(i)">@i</a>
                                </li>
                            }
                            if (rangeEnd < totalPages)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(page + 1)">&raquo;</a>
                        </li>
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(totalPages)">尾页</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<!-- 新建后台用户弹窗（v1.29.0 改版：入口定死为后台用户——平台角色必勾至少一个，
     建号即调 API provision 预置业务行并授权；App 用户走 app 端自助注册，不在此创建） -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Create" onsubmit="return checkCreateRoles(this)"><input type="hidden" name="tab" value="@currentTab" />
                <div class="modal-header">
                    <h6 class="modal-title">新建后台用户</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">用户名 <span class="text-danger">*</span></label>
                        <input type="text" name="userName" class="form-control" required />
                    </div>
                    @* 改动说明（v1.30.0）：不再输入密码——新账号自动使用系统初始密码，首次登录强制修改 *@
                    <div class="alert alert-info py-2 small">未设密码：新账号将使用系统初始密码，本人首次登录时会被要求必须修改。</div>                    <div class="mb-3">
                        <label class="form-label">姓名</label>
                        <input type="text" name="name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">邮箱</label>
                        <input type="email" name="email" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">手机号</label>
                        <input type="text" name="phoneNumber" class="form-control" />
                    </div>
                    @* 改动说明（v1.29.0）：建号即分配平台角色（后台建号入口=后台用户，角色必勾）；
                       Individual 不供勾选——App 用户由自助注册产生，非后台分配 *@
                    @{ var roleCatalog = ViewBag.RoleCatalog as IEnumerable<(string Name, string? Display)> ?? Enumerable.Empty<(string, string?)>(); }
                    <div class="mb-2">
                        <label class="form-label">平台角色 <span class="text-danger">*</span>（至少一个）</label>
                        <div class="list-group">
                            @foreach (var (rName, rDisplay) in roleCatalog)
                            {
                                if (rName == "Individual") { continue; }
                                <label class="list-group-item d-flex align-items-center gap-2 py-2">
                                    <input type="checkbox" class="form-check-input mt-0" name="roles" value="@rName" />
                                    <span>@(string.IsNullOrWhiteSpace(rDisplay) ? rName : rDisplay)
                                        @if (!string.IsNullOrWhiteSpace(rDisplay))
                                        {
                                            <span class="text-muted small">@rName</span>
                                        }
                                    </span>
                                </label>
                            }
                        </div>
                        <div class="form-text">普通用户请在 app 端自助注册，不在此创建</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">创建</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 重置密码弹窗 -->
<div class="modal fade" id="resetPwdModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="ResetPassword"><input type="hidden" name="tab" value="@currentTab" />
                <input type="hidden" name="id" id="resetPwdId" />
                <div class="modal-header">
                    <h6 class="modal-title">重置密码 - <span id="resetPwdName"></span></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @* 改动说明（v1.30.0）：不再人工输入新密码——一键重置为系统初始密码，
                       成功后提示条回显密码值供转告本人；该账号首次登录将被强制改密 *@
                    <p class="mb-0">将把该账号密码重置为<strong>系统初始密码</strong>（重置成功后页面会显示密码值，请转告本人）。</p>
                    <p class="text-muted small mb-0">该用户下次登录时会被要求必须修改密码。</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-warning">重置</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 平台角色弹窗（v1.25.0）：角色目录与勾选态来自 API RBAC，保存走差量分配/移除 -->
<div class="modal fade" id="platformRolesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">平台角色 - <span id="prName"></span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="prHint" class="text-muted small mb-2"></div>
                <div id="prList" class="list-group"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="prSave">保存</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('resetPwdModal').addEventListener('show.bs.modal', function(e) {
        document.getElementById('resetPwdId').value = e.relatedTarget.dataset.id;
        document.getElementById('resetPwdName').textContent = e.relatedTarget.dataset.name;
    });

    // 平台角色弹窗：打开时拉取现有角色+目录，保存走差量
    let prUserId = '';
    document.getElementById('platformRolesModal').addEventListener('show.bs.modal', function(e) {
        prUserId = e.relatedTarget.dataset.id;
        document.getElementById('prName').textContent = e.relatedTarget.dataset.name;
        document.getElementById('prList').innerHTML = '<div class="text-muted small">加载中…</div>';
        document.getElementById('prHint').textContent = '';
        fetch('@Url.Action("PlatformRoles")?id=' + encodeURIComponent(prUserId))
            .then(r => r.json())
            .then(d => {
                if (d.notProvisioned) {
                    document.getElementById('prHint').textContent = '该用户尚未登录过业务系统，需其登录一次后才能分配平台角色';
                }
                const held = new Set(d.roles || []);
                // 改动说明（v1.29.1）：目录排除 Individual——App 用户由自助注册自动授予，
                // 非后台分配对象，列出会误导管理员手工勾选
                document.getElementById('prList').innerHTML = (d.catalog || []).filter(r => r.name !== 'Individual').map(r =>
                    '<label class="list-group-item d-flex align-items-center gap-2">' +
                    '<input type="checkbox" class="form-check-input" value="' + r.name + '"' + (held.has(r.name) ? ' checked' : '') +
                    (r.name === 'Admin' ? ' data-admin="1"' : '') + ' />' +
                    '<span>' + (r.displayName || r.name) + (r.displayName && r.displayName !== r.name ? ' <span class="text-muted small">' + r.name + '</span>' : '') + (r.description ? ' <span class="text-muted small">' + r.description + '</span>' : '') + '</span></label>'
                ).join('') || '<div class="text-muted small">无可用角色</div>';
            })
            .catch(() => { document.getElementById('prList').innerHTML = '<div class="text-danger small">加载失败</div>'; });
    });
    document.getElementById('prSave').addEventListener('click', function() {
        const roles = Array.from(document.querySelectorAll('#prList input:checked')).map(i => i.value);
        const params = new URLSearchParams({ id: prUserId, userName: document.getElementById('prName').textContent });
        roles.forEach(r => params.append('roles', r));
        fetch('@Url.Action("SavePlatformRoles")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
            body: params.toString()
        }).then(r => r.json()).then(d => {
            if (d.ok) {
                bootstrap.Modal.getInstance(document.getElementById('platformRolesModal')).hide();
                if (window.showToast) showToast('success', d.message); else alert(d.message);
                setTimeout(() => location.reload(), 600);
            } else {
                if (window.showToast) showToast('error', d.message); else alert(d.message);
            }
        });
    });

  // 用户页签过滤（v1.29.1）：默认"后台用户"页签（本菜单语义=后台账号管理），
  // 纯当前页显隐，分页数据在服务端；跨页精确计数需后端联查，收益不抵复杂度
  (function () {
    const rows = Array.from(document.querySelectorAll('tbody tr[data-utype]'));
    const applyTab = (t) => rows.forEach(r => { r.style.display = (t === 'all' || r.dataset.utype === t) ? '' : 'none'; });
    document.querySelectorAll('#userTabs [data-utab]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#userTabs [data-utab]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyTab(btn.dataset.utab);
      });
    });
    applyTab('@currentTab');
  })();

  // 新建后台用户：平台角色至少勾一个（后端同校验，此处防无谓往返）v1.29.0
  function checkCreateRoles(form) {
    if (!form.querySelector('input[name="roles"]:checked')) {
      alert('请至少分配一个平台角色（后台用户必须有角色；App 用户请在 app 端自助注册）');
      return false;
    }
    return true;
  }
</script>
}