{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // 改动说明（v2.13.2 僵尸清理）：Admin 不直连任何数据库（数据一律经项目 API 代理），
  //   原 db_admin 连接串（仅用于创建两张从不读写的表）随 ApplicationDbContext 一并移除
  "ApiUrls": {
    "OpenFindBearingsApi": "https://localhost:7183",
    "OpenFindBearingsIdentity": "https://localhost:7201"
  },
  "Media": {
    "PublicBaseUrl": "https://<your-bff-domain>/media"
  },
  "Identity": {
    "Authority": "https://localhost:7201",
    "ClientId": "admin_client",
    "ClientSecret": "[REPLACE_ME]",
    "CallbackUrl": "https://localhost:7167/callback",
    "Scope": "openid profile email roles api:admin offline_access"
  }
